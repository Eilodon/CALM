{
  "name": "plan_change",
  "description": "Declares a ChangeIntent (what you're about to do, and why) as a formal, reviewable record, before writing anything -- returns a change_id to hand to review_change once a human/MRTR approves it. Idempotent ONLY while evidence hasn't drifted: repeated calls with the same kind+targets return the same change_id, but if source/config/graph/provider state changed since the matching intent was declared, that intent is superseded and this call mints a fresh change_id against current evidence instead (superseded_change_id on the response names the one replaced -- review_change on it now refuses with INTENT_SUPERSEDED). Surfaces (not blocks) a declared-vs-observed kind mismatch when a target's current uncommitted diff doesn't match what you declared. USE WHEN: a change needs formal review/authority rather than the lighter edit_context+confirm+reason gate. NOT FOR: the write itself (edit_lines/edit_symbol still do that) or a single quick low-risk edit (edit_context is enough there).",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ChangeTargetParam": {
        "description": "One file (optionally symbol-scoped) target of a `plan_change` call --\nwire shape for `calm_core::change::ChangeIntentTarget`.",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "qualified_name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path"
        ]
      }
    },
    "type": "object",
    "properties": {
      "kind": {
        "description": "Declared `change::classify::ChangeKind` name: `\"add\"`, `\"delete\"`,\n`\"whitespace\"`, `\"comment\"`, `\"doc_only\"`, `\"visibility\"`,\n`\"signature\"`, `\"manifest\"`, `\"test_only\"`, or `\"body\"`.",
        "type": "string"
      },
      "reason": {
        "description": "Free text for a human/reviewer -- never compared or matched against\nto authorize anything (invariant #3); `kind` is the only field\nchecked against reality (see `kind_mismatch` on the response).",
        "type": "string"
      },
      "targets": {
        "description": "At least one target. Order doesn't matter for idempotency (see\n`plan_change`'s own doc comment) or for the minted authority's\n`target_scope_digest`, both of which sort before hashing.",
        "type": "array",
        "items": {
          "$ref": "#/$defs/ChangeTargetParam"
        }
      }
    },
    "required": [
      "kind",
      "reason",
      "targets"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          },
          "review": {
            "description": "Set only on HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW / DIFF_DIGEST_MISMATCH — everything needed to relay-approve/decline via review_decide_via_agent_relay.",
            "anyOf": [
              {
                "$ref": "#/$defs/PendingReviewPacket"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_call": {
            "description": "The exact next tool call this error implies, if unambiguous — same shape as suggested_next.",
            "anyOf": [
              {
                "$ref": "#/$defs/SuggestedNext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "recoverable"
        ]
      },
      "PendingReviewPacket": {
        "description": "Wave 3 (audit follow-up, 2026-08-23): the structured shape of a\n`HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW`/`DIFF_DIGEST_MISMATCH` error's\n`review` field -- lets a calling agent relay-approve/decline without\never reading `pending_reviews` directly or reimplementing\n`hash_content` itself.\n\nWave 14 (audit follow-up, 2026-08-24): `diff_digest` is NOT\n`hash_content` of THIS packet's own `diff_preview` field -- it's\n`hash_content` of the full, unsanitized, uncapped diff stored server-\nside (see `from_pending`'s own comment). It exists to prove identity/\nfreshness (\"this is really the review you fetched, not a stale or\nguessed copy\"), not to let a caller verify \"the text I'm looking at\nhashes to this\" -- that's structurally impossible to guarantee anyway,\nsince different surfaces (this JSON packet vs. `calm review show`'s\nterminal output) apply different sanitize/cap transforms to the same\nunderlying diff and can't all match one digest. Callers must always\nCOPY this value verbatim, never recompute it from `diff_preview`.",
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string"
          },
          "diff_preview": {
            "type": "string"
          },
          "preview_truncated": {
            "description": "`true` when `diff_preview` was cut down from the full diff\n`diff_digest` covers -- see the struct's own doc comment.",
            "type": "boolean"
          },
          "diff_digest": {
            "type": "string"
          },
          "expires_at": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "review_id",
          "diff_preview",
          "preview_truncated",
          "diff_digest",
          "expires_at"
        ]
      },
      "SuggestedNext": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "args": true,
          "gate": {
            "description": "true iff skipping `tool` is hook-enforced, not just advisory.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "required_user_input": {
            "description": "Names any `tool` param intentionally left out of `args` because only a human can safely supply it (e.g. `approve`). Absent means `args` is already complete.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "tool",
          "reason"
        ]
      }
    },
    "required": [
      "flow_state"
    ],
    "type": "object",
    "properties": {
      "flow_state": {
        "description": "Wave 11 (item 3, \"unified continuation state machine\"): present on\nevery response regardless of success/error -- `\"ready\"` on success,\nor one of `needs_context`/`needs_human_review`/`needs_verification`/\n`blocked` on error (see `classify_error_state`'s own doc comment).\nLets an agent dispatch on ONE top-level field instead of\nmaintaining its own per-`code` remediation table across ~70\ndistinct codes.\n\nNamed `flow_state`, not the more obvious `state` (audit follow-up,\n2026-08-23): several tool-specific success structs (e.g.\n`EditTransactionStatusOutput`, `VerifyChangeOutput` in txn.rs) have\ntheir own unrelated `state` field, and this struct's `success: T` is\n`#[serde(flatten)]`ed -- a same-named field there would silently\nserialize as a SECOND `\"state\"` JSON key (serde's flatten writes\neach field independently; nothing dedupes it), with most JSON\nparsers then last-write-wins-ing over whichever value serialized\nsecond. `flow_state` is deliberately namespaced so no domain output\nstruct will ever pick the same name by coincidence again.",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ErrorDetail"
          },
          {
            "type": "null"
          }
        ]
      },
      "change_id": {
        "description": "Pass this to `review_change` once a human/MRTR approves it.",
        "type": "string"
      },
      "reused": {
        "description": "`true` when this call matched a prior `plan_change` call's declared\n`kind`+`targets` exactly and returned that intent's existing\n`change_id` instead of minting a new one.",
        "type": "boolean"
      },
      "snapshot_id": {
        "type": "string"
      },
      "superseded_change_id": {
        "description": "CCK-27 (audit follow-up): set when this call's declared kind+targets\nmatched a prior intent, but evidence had drifted since that intent\nwas declared -- that stale intent was marked `superseded` (see\n`change::intent::IntentStatus`) rather than reused, and this\n`change_id` replaces it. `review_change` on the superseded id now\nrefuses with `INTENT_SUPERSEDED`.",
        "type": [
          "string",
          "null"
        ]
      },
      "kind_mismatch": {
        "description": "`true` when at least one target's current uncommitted diff (working\ntree vs. `git show HEAD`) doesn't classify as the declared `kind` --\nbest-effort: silently `false` for a target with no git history, no\ndiff yet, or an unreadable file, since there's nothing to compare.",
        "type": "boolean"
      },
      "observed_kind": {
        "description": "The first mismatching target's actually-observed kind, if any.",
        "type": [
          "string",
          "null"
        ]
      },
      "mismatch_notes": {
        "description": "One human-readable line per mismatching target.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "suggested_next": {
        "anyOf": [
          {
            "$ref": "#/$defs/SuggestedNext"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
