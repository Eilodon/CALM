{
  "name": "verify_change",
  "description": "USE WHEN: you have a tx_id (from an edit_lines/edit_symbol response) and want to actually run cargo check on that change instead of just trusting applied:true. Only does anything if [verification] rust_check_on_write is enabled in .calm/config.json AND the file is .rs -- WS-6 first slice (docs/plans/2026-08-03-ws6-verification-pipeline-execution-plan.md), other languages/tiers not implemented yet. Runs cargo check inline, not backgrounded (same posture as retry_maintenance) -- can take a while on a large package. A tx_id that was never routed through verification (feature off, non-Rust file, or already resolved) returns a clear \"nothing to verify\" result, not an error. A failing check does NOT roll back the file already on disk.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "tx_id"
    ],
    "type": "object",
    "properties": {
      "tx_id": {
        "description": "tx_id from an edit_lines/edit_symbol response (or\nedit_transaction_status/repair_consistency output).",
        "type": "string"
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "recoverable"
        ]
      },
      "SuggestedNext": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "args": true,
          "gate": {
            "description": "Plan 3 §3.5(b): `Some(true)` iff skipping `tool` is actually\nhook-enforced (currently only the edit_context/edit_lines/edit_symbol\n→ diff_impact hints set this, via `suggested_gated`) — every other\nhint is left unset (`None`), meaning advisory-only. Lets an agent\ntell \"you'll be blocked if you skip this\" apart from \"you probably\nwant this next\" without re-deriving it from AGENTS.md prose each time.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "tool",
          "reason"
        ]
      }
    },
    "required": [
      "flow_state"
    ],
    "type": "object",
    "properties": {
      "flow_state": {
        "description": "Wave 11 (item 3, \"unified continuation state machine\"): present on\nevery response regardless of success/error -- `\"ready\"` on success,\nor one of `needs_context`/`needs_human_review`/`needs_verification`/\n`blocked` on error (see `classify_error_state`'s own doc comment).\nLets an agent dispatch on ONE top-level field instead of\nmaintaining its own per-`code` remediation table across ~70\ndistinct codes.\n\nNamed `flow_state`, not the more obvious `state` (audit follow-up,\n2026-08-23): several tool-specific success structs (e.g.\n`EditTransactionStatusOutput`, `VerifyChangeOutput` in txn.rs) have\ntheir own unrelated `state` field, and this struct's `success: T` is\n`#[serde(flatten)]`ed -- a same-named field there would silently\nserialize as a SECOND `\"state\"` JSON key (serde's flatten writes\neach field independently; nothing dedupes it), with most JSON\nparsers then last-write-wins-ing over whichever value serialized\nsecond. `flow_state` is deliberately namespaced so no domain output\nstruct will ever pick the same name by coincidence again.",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ErrorDetail"
          },
          {
            "type": "null"
          }
        ]
      },
      "tx_id": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "tier": {
        "description": "\"none\" (nothing to verify -- see `note`), \"unsupported\" (language\nnot covered yet), or \"semantic:cargo_check\" (the one real tier this\nfirst slice has).",
        "type": "string"
      },
      "verified": {
        "description": "`None` when `tier` is \"none\"/\"unsupported\" -- nothing was actually\nrun, so there's no pass/fail to report.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "state": {
        "description": "The transaction's state after this call: unchanged when `tier` is\n\"none\"/\"unsupported\", else DONE or FAILED depending on the check\nresult.",
        "type": "string"
      },
      "diagnostics": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "command": {
        "type": [
          "string",
          "null"
        ]
      },
      "note": {
        "type": "string"
      },
      "suggested_next": {
        "anyOf": [
          {
            "$ref": "#/$defs/SuggestedNext"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  }
}
