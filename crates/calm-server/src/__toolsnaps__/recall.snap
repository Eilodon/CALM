{
  "name": "recall",
  "description": "Retrieve durable notes saved by remember. USE WHEN: starting work on a topic you might have left notes about, or checking for known gotchas before touching an area. Pass `topic` for one exact note, `query` for a keyword search across all notes, or neither to list everything (most recently updated first).",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "topic": {
        "description": "Exact topic to fetch. Takes priority over `query` if both are set.",
        "type": [
          "string",
          "null"
        ]
      },
      "query": {
        "description": "Keyword search across topic + content: FTS5 phrase match, bm25-ranked\n(audit H1 — previously documented as \"SQL LIKE, case-insensitive\",\nstale since the FTS5 migration; see `escape_fts5_query`). Input is\nalways escaped into a literal phrase before matching. Ignored if\n`topic` is set.",
        "type": [
          "string",
          "null"
        ]
      },
      "include_quarantined": {
        "description": "`false` (default): a note `remember` quarantined (its content\nlooked prompt-injection-shaped) is excluded from the broad recall\npaths -- a `query` FTS search, and a no-args list-all. An exact\n`topic` lookup is a deliberate, targeted ask and always returns the\nnote regardless of this flag (mirroring `edit_context`'s own\nrelated-notes gate). Pass `true` to also include quarantined notes\nin the broad paths -- e.g. to review/clean them up. Every returned\nnote still carries its own `content_warning`/`quarantined` fields\nregardless of this flag, so the caller always knows what it's looking at.",
        "type": "boolean",
        "default": false
      }
    },
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          },
          "review": {
            "description": "Set only on HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW / DIFF_DIGEST_MISMATCH — everything needed to relay-approve/decline via review_decide_via_agent_relay.",
            "anyOf": [
              {
                "$ref": "#/$defs/PendingReviewPacket"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_call": {
            "description": "The exact next tool call this error implies, if unambiguous — same shape as suggested_next.",
            "anyOf": [
              {
                "$ref": "#/$defs/SuggestedNext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "recoverable"
        ]
      },
      "PendingReviewPacket": {
        "description": "Wave 3 (audit follow-up, 2026-08-23): the structured shape of a\n`HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW`/`DIFF_DIGEST_MISMATCH` error's\n`review` field -- lets a calling agent relay-approve/decline without\never reading `pending_reviews` directly or reimplementing\n`hash_content` itself.\n\nWave 14 (audit follow-up, 2026-08-24): `diff_digest` is NOT\n`hash_content` of THIS packet's own `diff_preview` field -- it's\n`hash_content` of the full, unsanitized, uncapped diff stored server-\nside (see `from_pending`'s own comment). It exists to prove identity/\nfreshness (\"this is really the review you fetched, not a stale or\nguessed copy\"), not to let a caller verify \"the text I'm looking at\nhashes to this\" -- that's structurally impossible to guarantee anyway,\nsince different surfaces (this JSON packet vs. `calm review show`'s\nterminal output) apply different sanitize/cap transforms to the same\nunderlying diff and can't all match one digest. Callers must always\nCOPY this value verbatim, never recompute it from `diff_preview`.",
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string"
          },
          "diff_preview": {
            "type": "string"
          },
          "preview_truncated": {
            "description": "`true` when `diff_preview` was cut down from the full diff\n`diff_digest` covers -- see the struct's own doc comment.",
            "type": "boolean"
          },
          "diff_digest": {
            "type": "string"
          },
          "expires_at": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "review_id",
          "diff_preview",
          "preview_truncated",
          "diff_digest",
          "expires_at"
        ]
      },
      "SuggestedNext": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "args": true,
          "gate": {
            "description": "true iff skipping `tool` is hook-enforced, not just advisory.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "required_user_input": {
            "description": "Names any `tool` param intentionally left out of `args` because only a human can safely supply it (e.g. `approve`). Absent means `args` is already complete.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "tool",
          "reason"
        ]
      },
      "MemoryNote": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "staleness": {
            "description": "\"unchecked\" (no file refs were ever captured for this note — nothing\nto compare), \"fresh\" (all captured refs still match), \"stale\" (a\nreferenced file changed since this note was written), or \"gone\" (a\nreferenced file was deleted) — set by `recall`, not `memory_note_row`.",
            "type": "string"
          },
          "stale_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/StaleRefOutput"
            }
          },
          "integrity": {
            "description": "Plan 3 §3.5(d): \"ok\" (`content_mac` present and verifies against\nthis project's key), \"mismatch\" (present but does NOT verify — the\nrow was altered by something other than `remember`), or\n\"unverified\" (no `content_mac` stored — a note written before this\nfeature existed). Set by `recall` via `calm_core::memory::verify_integrity`.",
            "type": "string"
          },
          "content_warning": {
            "description": "audit F7: same trust-surface treatment `source()` already gives file\ncontent — a note's `content` came from a prior `remember` call (this\nsession or a past one) and is untrusted text, same as any other\nstorage-backed channel. Set by `recall` via `injection_warning`;\n`None`/omitted when the content looks clean.",
            "type": [
              "string",
              "null"
            ]
          },
          "quarantined": {
            "description": "Set from the row's own `quarantined` column (not recomputed by\n`recall` the way `content_warning` is) -- `true` iff `remember`\nquarantined this note. Only ever appears in a response at all when\nthe caller passed `include_quarantined: true`, since a quarantined\nnote is excluded from every other `recall` path.",
            "type": "boolean"
          }
        },
        "required": [
          "topic",
          "content",
          "updated_at",
          "staleness",
          "integrity",
          "quarantined"
        ]
      },
      "StaleRefOutput": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "status": {
            "description": "\"changed\" (file still exists but its content hash no longer matches\nwhat `remember` captured) or \"deleted\" (file no longer exists).",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "status"
        ]
      }
    },
    "required": [
      "flow_state"
    ],
    "type": "object",
    "properties": {
      "flow_state": {
        "description": "Wave 11 (item 3, \"unified continuation state machine\"): present on\nevery response regardless of success/error -- `\"ready\"` on success,\nor one of `needs_context`/`needs_human_review`/`needs_verification`/\n`blocked` on error (see `classify_error_state`'s own doc comment).\nLets an agent dispatch on ONE top-level field instead of\nmaintaining its own per-`code` remediation table across ~70\ndistinct codes.\n\nNamed `flow_state`, not the more obvious `state` (audit follow-up,\n2026-08-23): several tool-specific success structs (e.g.\n`EditTransactionStatusOutput`, `VerifyChangeOutput` in txn.rs) have\ntheir own unrelated `state` field, and this struct's `success: T` is\n`#[serde(flatten)]`ed -- a same-named field there would silently\nserialize as a SECOND `\"state\"` JSON key (serde's flatten writes\neach field independently; nothing dedupes it), with most JSON\nparsers then last-write-wins-ing over whichever value serialized\nsecond. `flow_state` is deliberately namespaced so no domain output\nstruct will ever pick the same name by coincidence again.",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ErrorDetail"
          },
          {
            "type": "null"
          }
        ]
      },
      "notes": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/MemoryNote"
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "suggested_next": {
        "anyOf": [
          {
            "$ref": "#/$defs/SuggestedNext"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
