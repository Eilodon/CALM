{
  "name": "pattern_debt_register",
  "description": "Register a duplicate-code-pattern anchor for later re-checking via pattern_debt_status. Resolves `symbol` the same way edit_context does (same path/line disambiguation contract), then baselines with search(kind=\"similar\") against the resolved symbol's current location. Anchored by the symbol's qualified_name, NOT path+line — survives line-shifting edits elsewhere in the file; if the symbol itself is later renamed/removed, pattern_debt_status reports anchor_lost instead of a false \"resolved\". USE WHEN: you just found/fixed one instance of a duplicated bug pattern and want to track how many other instances remain. Re-registering the same symbol replaces its note and re-baselines. Needs the embeddings feature ready — returns EMBEDDINGS_NOT_READY otherwise, same degradation as search(kind=\"similar\")/kind=\"semantic\".",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "symbol",
      "note"
    ],
    "type": "object",
    "properties": {
      "symbol": {
        "description": "Bare symbol name (not a `path::name` qualified name) — same\nresolution contract as `edit_context`.",
        "type": "string"
      },
      "path": {
        "description": "Narrows the search to one file when `symbol` alone is ambiguous.",
        "type": [
          "string",
          "null"
        ]
      },
      "line": {
        "description": "Disambiguates same-named symbols in the same file.",
        "type": [
          "integer",
          "null"
        ],
        "format": "int64"
      },
      "qualified_name": {
        "description": "3.4 (Wave 3): exact `qualified_name` from a prior `search`/`locate`\nresult -- when set, resolves directly by identity and `path`/`line`\nare ignored, so this can never come back ambiguous even for a\nglobally-common bare `symbol` name.",
        "type": [
          "string",
          "null"
        ]
      },
      "note": {
        "description": "Free-text description of the bug/duplication pattern this anchor\ntracks — shown back on every `pattern_debt_status` check.",
        "type": "string"
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          },
          "review": {
            "description": "Set only on HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW / DIFF_DIGEST_MISMATCH — everything needed to relay-approve/decline via review_decide_via_agent_relay.",
            "anyOf": [
              {
                "$ref": "#/$defs/PendingReviewPacket"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_call": {
            "description": "The exact next tool call this error implies, if unambiguous — same shape as suggested_next.",
            "anyOf": [
              {
                "$ref": "#/$defs/SuggestedNext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "recoverable"
        ]
      },
      "PendingReviewPacket": {
        "description": "Wave 3 (audit follow-up, 2026-08-23): the structured shape of a\n`HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW`/`DIFF_DIGEST_MISMATCH` error's\n`review` field -- lets a calling agent relay-approve/decline without\never reading `pending_reviews` directly or reimplementing\n`hash_content` itself.\n\nWave 14 (audit follow-up, 2026-08-24): `diff_digest` is NOT\n`hash_content` of THIS packet's own `diff_preview` field -- it's\n`hash_content` of the full, unsanitized, uncapped diff stored server-\nside (see `from_pending`'s own comment). It exists to prove identity/\nfreshness (\"this is really the review you fetched, not a stale or\nguessed copy\"), not to let a caller verify \"the text I'm looking at\nhashes to this\" -- that's structurally impossible to guarantee anyway,\nsince different surfaces (this JSON packet vs. `calm review show`'s\nterminal output) apply different sanitize/cap transforms to the same\nunderlying diff and can't all match one digest. Callers must always\nCOPY this value verbatim, never recompute it from `diff_preview`.",
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string"
          },
          "diff_preview": {
            "type": "string"
          },
          "preview_truncated": {
            "description": "`true` when `diff_preview` was cut down from the full diff\n`diff_digest` covers -- see the struct's own doc comment.",
            "type": "boolean"
          },
          "diff_digest": {
            "type": "string"
          },
          "expires_at": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "review_id",
          "diff_preview",
          "preview_truncated",
          "diff_digest",
          "expires_at"
        ]
      },
      "SuggestedNext": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "args": true,
          "gate": {
            "description": "true iff skipping `tool` is hook-enforced, not just advisory.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "required_user_input": {
            "description": "Names any `tool` param intentionally left out of `args` because only a human can safely supply it (e.g. `approve`). Absent means `args` is already complete.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "tool",
          "reason"
        ]
      },
      "AmbiguousCandidate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "format": "int64"
          },
          "line_end": {
            "type": "integer",
            "format": "int64"
          },
          "class_context": {
            "type": [
              "string",
              "null"
            ]
          },
          "caller_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "signature": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "path",
          "kind",
          "line_start",
          "line_end"
        ]
      },
      "Caveat": {
        "description": "Structured, machine-checkable hint attached to a tool result whose\nliteral content (empty list / not-found) could otherwise be misread as\nproof of absence. `class` lets a safety gate branch without parsing\n`message`; `message` is the human-readable explanation. Design mirrors\nzzet/gortex's `ZeroEdgeCaveat` (Apache-2.0) — reimplemented against\nCALM's own resolver shape, not a line-for-line port.",
        "type": "object",
        "properties": {
          "class": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "class",
          "message"
        ]
      }
    },
    "required": [
      "flow_state"
    ],
    "type": "object",
    "properties": {
      "flow_state": {
        "description": "See `ToolOutcome::flow_state`'s own doc comment -- same contract\n(including why it's named `flow_state`, not `state`), plus\n`ambiguous`/`not_found` both map onto `needs_context` (the caller\nneeds one more piece of information: which candidate, or a\ndifferent query).",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ErrorDetail"
          },
          {
            "type": "null"
          }
        ]
      },
      "ambiguous": {
        "type": "boolean"
      },
      "total": {
        "description": "Total candidates matched before the display cap of\n`MAX_AMBIGUOUS_CANDIDATES`. `truncated` is `true` when `total >\ncandidates.len()`, telling the caller there are more matches than\nshown and to narrow with `path`/`line` — the list is never silently\npresented as the complete set.",
        "type": "integer",
        "format": "uint",
        "minimum": 0
      },
      "truncated": {
        "type": "boolean"
      },
      "candidates": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/AmbiguousCandidate"
        }
      },
      "topic": {
        "description": "Stable id for this anchor — pass to `pattern_debt_status(topic=...)`.\nAlways equal to `anchor_qualified_name` at registration time.",
        "type": "string"
      },
      "anchor_qualified_name": {
        "type": "string"
      },
      "baseline_count": {
        "description": "Similar-instance count at registration time (excludes the anchor\nitself), from `search(kind=\"similar\")`.",
        "type": "integer",
        "format": "int64"
      },
      "suggested_next": {
        "anyOf": [
          {
            "$ref": "#/$defs/SuggestedNext"
          },
          {
            "type": "null"
          }
        ]
      },
      "caveat": {
        "description": "Advisory hint on an empty/not-found result. Never set alongside a\npopulated `success` unless a tool opts in via `with_caveat` (e.g.\n`callers` on zero direct callers).",
        "anyOf": [
          {
            "$ref": "#/$defs/Caveat"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
