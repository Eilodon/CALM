{
  "name": "edit_context",
  "description": "ALWAYS CALL THIS before any code modification — mandatory, never skip. USE WHEN: you are about to edit, refactor, or delete a symbol. NOT FOR: read-only inspection (use symbol_info + source). NOT post-edit (use diff_impact).",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "symbol": {
        "description": "Bare symbol name (not a `path::name` qualified name) — e.g. `load`,\nnot `crates/calm-core/src/embedding.rs::Embedder::load`. Omit ONLY\nin range mode (see `end_line`), where a raw `[line, end_line]`\nwindow is reviewed directly with no symbol resolution — mirrors\n`source`'s own `symbol`-omitted range mode (Wave 8 audit follow-up,\nP0-A).",
        "type": [
          "string",
          "null"
        ]
      },
      "path": {
        "description": "Narrows the search to one file when `symbol` alone is ambiguous\nacross the repo. Repo-relative, e.g. `crates/calm-core/src/embedding.rs`.\nRequired in range mode.",
        "type": [
          "string",
          "null"
        ]
      },
      "line": {
        "description": "Disambiguates same-named symbols in the same file (e.g. a\n`#[cfg(feature)]` real impl vs. its stub) — any line within the\nintended candidate's range, as echoed in an earlier `ambiguous`\nresponse's `line_start`/`line_end`. In range mode (symbol omitted)\nthis is the 1-indexed START line of the window to review.",
        "type": [
          "integer",
          "null"
        ],
        "format": "int64"
      },
      "qualified_name": {
        "description": "5.3 (Wave 5): exact `qualified_name` from a prior `search`/`locate`\nresult — when set, resolves directly by identity and `path`/`line`\nare ignored, so this can never come back ambiguous even for a\nglobally-common bare `symbol` name. Still flows through the same\nlive-verification every resolution does (Wave 1's `verify_live`).\nIgnored in range mode.",
        "type": [
          "string",
          "null"
        ]
      },
      "end_line": {
        "description": "Range mode: 1-indexed, inclusive END line of a raw window to\nreview directly from `path` with no symbol resolution — for\nmodule-level or between-symbol code no symbol range covers (pure\nwhitespace/comment/module-constant/gap regions). Requires `path` +\n`line` (the start) and `symbol` omitted. Ignored in symbol mode.\nWave 8 (audit follow-up, P0-A): before this, Strict mode had no\nsuccess path at all for editing such a region — neither the\nconfirm/reason gate nor the full ReviewAuthority path could ever\nclear, because nothing could review it first.",
        "type": [
          "integer",
          "null"
        ],
        "format": "int64"
      },
      "if_none_match": {
        "description": "`edges_etag` from a prior `edit_context` call on this exact symbol —\nif the caller/callee lists haven't changed since, the response omits\n`callers`/`callees` and sets `edges_not_modified: true`. Every other\nfield (`risk_assessment`, `dead_code_confidence`, `blast_radius`,\n`trend`, `co_changed_files`, `range_checksum`) is always recomputed\nand returned in full regardless — never gated behind this etag, since\nthis is the mandatory pre-edit safety tool and none of those may go\nsilently stale.",
        "type": [
          "string",
          "null"
        ]
      },
      "proposed_new_text": {
        "description": "P0-3 (audit follow-up, 2026-08-23): opt-in full replacement text for\nthe reviewed range (the symbol's own `[line_start, line_end]` in\nsymbol mode, `[line, end_line]` in range mode) -- when set, the\nsame `compute_touch_risk` signature-change detection the real\n`edit_lines`/`edit_symbol` write gate uses at spend time also runs\nhere at mint time, against this exact text, instead of the\nplaceholder empty hunk. Without this, `edit_context` has no\nproposed content yet and can only ever mint an authority with\n`signature_changed=false` -- correct as a conservative default, but\na dead end for a genuine signature edit: the minted RiskVector\nunder-claims risk relative to what `edit_lines_impl_gated`\nindependently recomputes from the real diff at spend time, so\n`AUTHORITY_STALE_RISK_VECTOR` fires deterministically for every\nsignature change that goes through the authority flow, with no\nsuccessful path (see the audit finding this closes). Assumes a\nWHOLE-RANGE replace, matching `edit_symbol`'s default `\"replace\"`\nposition -- not meaningful for a narrower `edit_lines` hunk within\nthe range, which should omit this and rely on the conservative\ndefault instead.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          },
          "review": {
            "description": "Set only on HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW / DIFF_DIGEST_MISMATCH — everything needed to relay-approve/decline via review_decide_via_agent_relay.",
            "anyOf": [
              {
                "$ref": "#/$defs/PendingReviewPacket"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_call": {
            "description": "The exact next tool call this error implies, if unambiguous — same shape as suggested_next.",
            "anyOf": [
              {
                "$ref": "#/$defs/SuggestedNext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "recoverable"
        ]
      },
      "PendingReviewPacket": {
        "description": "Wave 3 (audit follow-up, 2026-08-23): the structured shape of a\n`HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW`/`DIFF_DIGEST_MISMATCH` error's\n`review` field -- lets a calling agent relay-approve/decline without\never reading `pending_reviews` directly or reimplementing\n`hash_content` itself.\n\nWave 14 (audit follow-up, 2026-08-24): `diff_digest` is NOT\n`hash_content` of THIS packet's own `diff_preview` field -- it's\n`hash_content` of the full, unsanitized, uncapped diff stored server-\nside (see `from_pending`'s own comment). It exists to prove identity/\nfreshness (\"this is really the review you fetched, not a stale or\nguessed copy\"), not to let a caller verify \"the text I'm looking at\nhashes to this\" -- that's structurally impossible to guarantee anyway,\nsince different surfaces (this JSON packet vs. `calm review show`'s\nterminal output) apply different sanitize/cap transforms to the same\nunderlying diff and can't all match one digest. Callers must always\nCOPY this value verbatim, never recompute it from `diff_preview`.",
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string"
          },
          "diff_preview": {
            "type": "string"
          },
          "preview_truncated": {
            "description": "`true` when `diff_preview` was cut down from the full diff\n`diff_digest` covers -- see the struct's own doc comment.",
            "type": "boolean"
          },
          "diff_digest": {
            "type": "string"
          },
          "expires_at": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "review_id",
          "diff_preview",
          "preview_truncated",
          "diff_digest",
          "expires_at"
        ]
      },
      "SuggestedNext": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "args": true,
          "gate": {
            "description": "true iff skipping `tool` is hook-enforced, not just advisory.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "required_user_input": {
            "description": "Names any `tool` param intentionally left out of `args` because only a human can safely supply it (e.g. `approve`). Absent means `args` is already complete.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "tool",
          "reason"
        ]
      },
      "AmbiguousCandidate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "format": "int64"
          },
          "line_end": {
            "type": "integer",
            "format": "int64"
          },
          "class_context": {
            "type": [
              "string",
              "null"
            ]
          },
          "caller_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "signature": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "path",
          "kind",
          "line_start",
          "line_end"
        ]
      },
      "CallerEntry": {
        "type": "object",
        "properties": {
          "symbol": {
            "description": "`path::name` (or `path::Class::name`) of the calling symbol — split on the first `::` for the file path standalone.",
            "type": "string"
          },
          "edge_confidence": {
            "type": "string"
          },
          "formal_source": {
            "description": "Source behind edge_confidence == \"formal\": \"stack_graphs\" | \"scip\" | \"lsp\". None when edge_confidence != \"formal\". See ADR-0002 — not equally trustworthy.",
            "type": [
              "string",
              "null"
            ]
          },
          "edge_kind": {
            "description": "\"call\" or \"reference\" (e.g. a SQL JOIN reading a table) — see call_edges.edge_kind.",
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "preview": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "symbol",
          "edge_confidence",
          "edge_kind"
        ]
      },
      "CalleeEntry": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "edge_confidence": {
            "type": "string"
          },
          "formal_source": {
            "description": "See `CallerEntry::formal_source`.",
            "type": [
              "string",
              "null"
            ]
          },
          "edge_kind": {
            "description": "See `CallerEntry::edge_kind`.",
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "preview": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "symbol",
          "path",
          "edge_confidence",
          "edge_kind"
        ]
      },
      "BlastRadiusInfo": {
        "type": "object",
        "properties": {
          "transitive": {
            "type": "integer",
            "format": "int64"
          },
          "files_affected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capped": {
            "description": "Wave 9 (audit follow-up, finding #5): whether the transitive BFS hit\n`callers.max_depth_cap`/`callers.transitive_timeout_ms` before\nfinishing -- `transitive`/`files_affected` are then a LOWER bound,\nnot the true blast radius, same \"truncated, don't trust as exact\"\nmeaning `callers_truncated`/`callees_truncated` already carry on\nthis same output. Previously computed (`transitive_bfs`'s second\nreturn value) but silently discarded as `_capped`. `Some(true)`\nwhen capped, absent otherwise -- never `Some(false)`.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "transitive",
          "files_affected"
        ]
      },
      "RiskAssessmentOutput": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "level",
          "reasons"
        ]
      },
      "GatePredictionOutput": {
        "description": "Predicts exactly what the `edit_lines`/`edit_symbol` write gate will do\nfor this touched range — UPGRADE_PLAN.md FIX2/F2b. Built from the same\n`compute_touch_risk` + `classify_gate` the real gate uses\n(`edit_lines_impl_gated`), over the same `[c.line_start, c.line_end]`\nrange, so it can never drift from the gate's actual behavior. Distinct\nfrom `risk_assessment` above: that field is an advisory review-risk\nsignal (entropy, dead-code confidence); THIS is what determines a write\nblock.",
        "type": "object",
        "properties": {
          "will_block": {
            "description": "true iff a write here with confirm: false would be rejected.",
            "type": "boolean"
          },
          "is_hub": {
            "description": "This exact symbol's own is_hub (distinct from will_block, which also covers the wider touched range).",
            "type": "boolean"
          },
          "hub_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "blocking_symbols": {
            "description": "Touched symbols (qualified names) that are themselves a hub, when different from this one.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "description": "`\"none\"` | `\"confirm\"` | `\"edit_context+confirm+grounded_reason\"`.",
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "will_block",
          "is_hub",
          "blocking_symbols",
          "requires"
        ]
      },
      "TrendOutput": {
        "description": "How much `caller_count`/`coreness`/`is_hub` moved since the oldest snapshot\nstill at least `EDIT_CONTEXT_TREND_LOOKBACK_DAYS` old — see\n`calm_core::fitness::compute_trend`.",
        "type": "object",
        "properties": {
          "compared_to": {
            "type": "string"
          },
          "caller_count_delta": {
            "type": "integer",
            "format": "int64"
          },
          "coreness_delta": {
            "type": "integer",
            "format": "int64"
          },
          "is_hub_changed": {
            "type": "boolean"
          }
        },
        "required": [
          "compared_to",
          "caller_count_delta",
          "coreness_delta",
          "is_hub_changed"
        ]
      },
      "CoChangedFileOutput": {
        "description": "A file with no import/call relationship to the symbol's file, but that\nhistorically changed alongside it in the same commit — a coupling signal\nthe static graph cannot see. See `calm_core::analysis::cochange`.",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "co_change_count": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "last_co_changed": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "co_change_count"
        ]
      },
      "RelatedNoteOutput": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "excerpt": {
            "description": "First 160 characters of the note's content — not the full note;\ncall `recall(topic=...)` for the whole thing.",
            "type": "string"
          },
          "specificity": {
            "description": "`\"symbol\"` when the note's text mentions the resolved symbol's bare\nname (higher trust), `\"file\"` when it only matched at file level\n(the note references this file but may be about a different symbol\nin it — calibrate trust accordingly).",
            "type": "string"
          },
          "staleness": {
            "description": "`\"fresh\"` / `\"stale\"` / `\"gone\"` (same convention as `recall`'s\nper-note staleness) / `\"unknown\"` when the staleness check itself\nfailed (fail-open: the note still surfaces, just without a\nconfident freshness read).",
            "type": "string"
          }
        },
        "required": [
          "topic",
          "excerpt",
          "specificity",
          "staleness"
        ]
      },
      "Caveat": {
        "description": "Structured, machine-checkable hint attached to a tool result whose\nliteral content (empty list / not-found) could otherwise be misread as\nproof of absence. `class` lets a safety gate branch without parsing\n`message`; `message` is the human-readable explanation. Design mirrors\nzzet/gortex's `ZeroEdgeCaveat` (Apache-2.0) — reimplemented against\nCALM's own resolver shape, not a line-for-line port.",
        "type": "object",
        "properties": {
          "class": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "class",
          "message"
        ]
      }
    },
    "required": [
      "flow_state"
    ],
    "type": "object",
    "properties": {
      "flow_state": {
        "description": "See `ToolOutcome::flow_state`'s own doc comment -- same contract\n(including why it's named `flow_state`, not `state`), plus\n`ambiguous`/`not_found` both map onto `needs_context` (the caller\nneeds one more piece of information: which candidate, or a\ndifferent query).",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ErrorDetail"
          },
          {
            "type": "null"
          }
        ]
      },
      "ambiguous": {
        "type": "boolean"
      },
      "total": {
        "description": "Total candidates matched before the display cap of\n`MAX_AMBIGUOUS_CANDIDATES`. `truncated` is `true` when `total >\ncandidates.len()`, telling the caller there are more matches than\nshown and to narrow with `path`/`line` — the list is never silently\npresented as the complete set.",
        "type": "integer",
        "format": "uint",
        "minimum": 0
      },
      "truncated": {
        "type": "boolean"
      },
      "candidates": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/AmbiguousCandidate"
        }
      },
      "symbol": {
        "type": "string"
      },
      "edges_ready": {
        "type": "boolean"
      },
      "index_freshness": {
        "type": "string"
      },
      "callers": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/CallerEntry"
        }
      },
      "callees": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/CalleeEntry"
        }
      },
      "callers_truncated": {
        "description": "`true` when `callers` was cut down to `config.callers.direct_list_cap`\nentries (a real hub symbol can have 50-200+) — `blast_radius`'s own\ncounts are unaffected, only this raw per-entry dump is capped.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "callees_truncated": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "blast_radius": {
        "$ref": "#/$defs/BlastRadiusInfo"
      },
      "range_checksum": {
        "description": "Hash of the symbol's current `[line_start, line_end]` — pass this\nstraight to `edit_lines`/`edit_symbol` as `expected_hash` to skip\nthe \"learn the hash\" preview round trip. Absent if the file\ncouldn't be read from disk.",
        "type": [
          "string",
          "null"
        ]
      },
      "risk_assessment": {
        "anyOf": [
          {
            "$ref": "#/$defs/RiskAssessmentOutput"
          },
          {
            "type": "null"
          }
        ]
      },
      "gate_prediction": {
        "description": "Exactly what the `edit_lines`/`edit_symbol` write gate will do for\nthis range (FIX2/F2b) — unlike `risk_assessment` above (advisory),\nthis is what actually determines a write block. See\n`GatePredictionOutput`'s own doc comment.",
        "$ref": "#/$defs/GatePredictionOutput"
      },
      "dead_code_confidence": {
        "description": "`\"none\"` (confirmed not dead — entry point, test, or has confirmed\ncallers), `\"high\"`/`\"medium\"`/`\"low\"` confidence it genuinely is dead\ncode — see `calm_core::analysis::dead_code::compute_dead_code_confidence`.\nAlso feeds `risk_assessment`: a 0-caller symbol only keeps \"low\" risk\nwhen this independently agrees (`\"high\"`/`\"medium\"`).",
        "type": "string"
      },
      "dead_code_source": {
        "description": "`\"static\"` or `\"static+coverage\"` — whether a runtime coverage file\n(see `scripts/gen-coverage.sh`) was available to inform `dead_code_confidence`.",
        "type": "string"
      },
      "trend": {
        "description": "Absent when there's no snapshot yet at least `EDIT_CONTEXT_TREND_LOOKBACK_DAYS`\nold (e.g. `calm fitness-check` hasn't run for that long) — not an error.",
        "anyOf": [
          {
            "$ref": "#/$defs/TrendOutput"
          },
          {
            "type": "null"
          }
        ]
      },
      "co_changed_files": {
        "description": "Empty when git is unavailable or no file co-changed with this\nsymbol's file often enough to clear `config.cochange.min_co_changes`\n— not an error signal, most edits legitimately have none.",
        "type": "array",
        "items": {
          "$ref": "#/$defs/CoChangedFileOutput"
        }
      },
      "related_notes": {
        "description": "Notes saved via `remember` that reference this symbol's file —\nsurfaced automatically so a known gotcha isn't missed just because\nnobody thought to call `recall` first. Empty is the common case, not\nan error signal. See `CalmServer::related_notes` for the specificity/\nfail-open/content-safety rules governing what qualifies.",
        "type": "array",
        "items": {
          "$ref": "#/$defs/RelatedNoteOutput"
        }
      },
      "edges_etag": {
        "description": "Fingerprint of `callers`+`callees` only (see `if_none_match` on\n`EditContextParams`) — every other field above is always fresh on\nevery call, never gated behind this.",
        "type": [
          "string",
          "null"
        ]
      },
      "edges_not_modified": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "suggested_next": {
        "anyOf": [
          {
            "$ref": "#/$defs/SuggestedNext"
          },
          {
            "type": "null"
          }
        ]
      },
      "change_id": {
        "description": "CCK-10 (#65): `ChangeIntent::intent_id` for the authority minted by\nthis call, if minting succeeded (fail-open — absent on any minting\nerror, never blocks the mandatory pre-edit fields above). Pass\nalongside `authority_id` to `edit_lines`/`edit_symbol` to use the\nauthority-validated write path instead of `confirm`/`reason`/`cites`.",
        "type": [
          "string",
          "null"
        ]
      },
      "authority_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "authority_expires_at": {
        "description": "Unix seconds — the minted authority is refused (single-use, TTL-\nbound) after this even if every bound field still matches.",
        "type": [
          "number",
          "null"
        ],
        "format": "double"
      },
      "caveat": {
        "description": "Advisory hint on an empty/not-found result. Never set alongside a\npopulated `success` unless a tool opts in via `with_caveat` (e.g.\n`callers` on zero direct callers).",
        "anyOf": [
          {
            "$ref": "#/$defs/Caveat"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
