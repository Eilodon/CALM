{
  "name": "fitness_report",
  "description": "Repo-wide codebase health snapshot (hub concentration, dead code, complexity, edge coverage, architecture-boundary/config-drift violations) against configurable thresholds — the same checks `calm fitness-check` runs in CI, queryable mid-session instead of waiting on a pipeline. USE WHEN: you want a big-picture health pulse-check. NOT FOR: per-file/per-symbol risk (use hotspots/edit_context for that).",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "recoverable"
        ]
      },
      "FitnessCheckItemOutput": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "format": "double"
          },
          "threshold": {
            "type": "number",
            "format": "double"
          },
          "passed": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "metric",
          "value",
          "threshold",
          "passed",
          "message"
        ]
      },
      "FitnessMetricsOutput": {
        "type": "object",
        "properties": {
          "hub_count": {
            "type": "integer",
            "format": "int64"
          },
          "hub_pct": {
            "type": "number",
            "format": "double"
          },
          "avg_coreness": {
            "type": "number",
            "format": "double"
          },
          "dead_code_pct": {
            "type": "number",
            "format": "double"
          },
          "hotspot_risk": {
            "type": "number",
            "format": "double"
          },
          "edge_coverage_pct": {
            "type": "number",
            "format": "double"
          },
          "high_complexity_pct": {
            "type": "number",
            "format": "double"
          },
          "high_complexity_pct_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "avg_instability": {
            "type": "number",
            "format": "double"
          },
          "avg_distance": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "martin_files_measured": {
            "type": "integer",
            "format": "int64"
          },
          "martin_files_total": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "hub_count",
          "hub_pct",
          "avg_coreness",
          "dead_code_pct",
          "hotspot_risk",
          "edge_coverage_pct",
          "high_complexity_pct",
          "avg_instability",
          "martin_files_measured",
          "martin_files_total"
        ]
      },
      "BoundaryViolationOutput": {
        "type": "object",
        "properties": {
          "from_path": {
            "type": "string"
          },
          "to_path": {
            "type": "string"
          },
          "rule_from": {
            "type": "string"
          },
          "rule_to": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "from_path",
          "to_path",
          "rule_from",
          "rule_to"
        ]
      },
      "ConfigDriftFindingOutput": {
        "type": "object",
        "properties": {
          "doc_path": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        },
        "required": [
          "doc_path",
          "reference"
        ]
      },
      "SuggestedNext": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "args": true,
          "gate": {
            "description": "Plan 3 §3.5(b): `Some(true)` iff skipping `tool` is actually\nhook-enforced (currently only the edit_context/edit_lines/edit_symbol\n→ diff_impact hints set this, via `suggested_gated`) — every other\nhint is left unset (`None`), meaning advisory-only. Lets an agent\ntell \"you'll be blocked if you skip this\" apart from \"you probably\nwant this next\" without re-deriving it from AGENTS.md prose each time.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "tool",
          "reason"
        ]
      }
    },
    "required": [
      "flow_state"
    ],
    "type": "object",
    "properties": {
      "flow_state": {
        "description": "Wave 11 (item 3, \"unified continuation state machine\"): present on\nevery response regardless of success/error -- `\"ready\"` on success,\nor one of `needs_context`/`needs_human_review`/`needs_verification`/\n`blocked` on error (see `classify_error_state`'s own doc comment).\nLets an agent dispatch on ONE top-level field instead of\nmaintaining its own per-`code` remediation table across ~70\ndistinct codes.\n\nNamed `flow_state`, not the more obvious `state` (audit follow-up,\n2026-08-23): several tool-specific success structs (e.g.\n`EditTransactionStatusOutput`, `VerifyChangeOutput` in txn.rs) have\ntheir own unrelated `state` field, and this struct's `success: T` is\n`#[serde(flatten)]`ed -- a same-named field there would silently\nserialize as a SECOND `\"state\"` JSON key (serde's flatten writes\neach field independently; nothing dedupes it), with most JSON\nparsers then last-write-wins-ing over whichever value serialized\nsecond. `flow_state` is deliberately namespaced so no domain output\nstruct will ever pick the same name by coincidence again.",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ErrorDetail"
          },
          {
            "type": "null"
          }
        ]
      },
      "passed": {
        "type": "boolean"
      },
      "checks": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/FitnessCheckItemOutput"
        }
      },
      "metrics": {
        "$ref": "#/$defs/FitnessMetricsOutput"
      },
      "boundary_violations": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/BoundaryViolationOutput"
        }
      },
      "config_drift": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/ConfigDriftFindingOutput"
        }
      },
      "suggested_next": {
        "anyOf": [
          {
            "$ref": "#/$defs/SuggestedNext"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
