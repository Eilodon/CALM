{
  "name": "locate",
  "description": "Compound: search + file_overview + symbol_info in 1 call (66% reduction). USE INSTEAD OF calling search then file_overview then symbol_info separately. NOT FOR: reading source (use source after locate), pre-edit (use edit_context).",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "query"
    ],
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "kind": {
        "description": "Same values as `search`'s `kind` — `\"hybrid\"` (default, 3.1 Wave 3),\n`\"symbol\"`, `\"text\"`, `\"file\"`, or `\"semantic\"`.",
        "type": [
          "string",
          "null"
        ]
      },
      "depth": {
        "description": "How much to enrich the top hit beyond `results`, in increasing\ncost/token size:\n- `\"search_only\"`: just `results` — cheapest, use when you only\n  need the match list (e.g. checking existence, or `kind` is\n  `\"text\"`/`\"file\"` where there's no symbol to enrich anyway).\n- `\"with_file\"`: adds `file_overview` (every symbol in the top\n  hit's file, with signatures) — can be large for a big file.\n- `\"with_symbol\"` (default): adds both `file_overview` and\n  `top_symbol` (full metadata for just the top hit).\n\n`kind` `\"text\"`/`\"file\"` auto-downgrades `\"with_symbol\"` to\n`\"with_file\"` (reported via `depth_adjusted`) since a text/file\nmatch has no single symbol to enrich.",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "description": "Max entries in `results`. Default 10.",
        "type": [
          "integer",
          "null"
        ],
        "format": "uint",
        "minimum": 0
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          },
          "review": {
            "description": "Set only on HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW / DIFF_DIGEST_MISMATCH — everything needed to relay-approve/decline via review_decide_via_agent_relay.",
            "anyOf": [
              {
                "$ref": "#/$defs/PendingReviewPacket"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_call": {
            "description": "The exact next tool call this error implies, if unambiguous — same shape as suggested_next.",
            "anyOf": [
              {
                "$ref": "#/$defs/SuggestedNext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "recoverable"
        ]
      },
      "PendingReviewPacket": {
        "description": "Wave 3 (audit follow-up, 2026-08-23): the structured shape of a\n`HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW`/`DIFF_DIGEST_MISMATCH` error's\n`review` field -- lets a calling agent relay-approve/decline without\never reading `pending_reviews` directly or reimplementing\n`hash_content` itself.\n\nWave 14 (audit follow-up, 2026-08-24): `diff_digest` is NOT\n`hash_content` of THIS packet's own `diff_preview` field -- it's\n`hash_content` of the full, unsanitized, uncapped diff stored server-\nside (see `from_pending`'s own comment). It exists to prove identity/\nfreshness (\"this is really the review you fetched, not a stale or\nguessed copy\"), not to let a caller verify \"the text I'm looking at\nhashes to this\" -- that's structurally impossible to guarantee anyway,\nsince different surfaces (this JSON packet vs. `calm review show`'s\nterminal output) apply different sanitize/cap transforms to the same\nunderlying diff and can't all match one digest. Callers must always\nCOPY this value verbatim, never recompute it from `diff_preview`.",
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string"
          },
          "diff_preview": {
            "type": "string"
          },
          "preview_truncated": {
            "description": "`true` when `diff_preview` was cut down from the full diff\n`diff_digest` covers -- see the struct's own doc comment.",
            "type": "boolean"
          },
          "diff_digest": {
            "type": "string"
          },
          "expires_at": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "review_id",
          "diff_preview",
          "preview_truncated",
          "diff_digest",
          "expires_at"
        ]
      },
      "SuggestedNext": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "args": true,
          "gate": {
            "description": "true iff skipping `tool` is hook-enforced, not just advisory.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "required_user_input": {
            "description": "Names any `tool` param intentionally left out of `args` because only a human can safely supply it (e.g. `approve`). Absent means `args` is already complete.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "tool",
          "reason"
        ]
      },
      "SearchResultItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "qualified_name": {
            "description": "3.4 (Wave 3, P1-3): the symbol's exact `qualified_name`, restored\nafter being dropped from this output type -- feed it straight into\n`source`/`symbol_info`/`callers`/`callees`/`reference_impact`/`path`/\n`pattern_debt_register`'s new `qualified_name` param to resolve by\nidentity, never `Ambiguous`, even for a globally-common bare name.\nPresent only when `kind` is also present -- both are populated from\nthe same live `symbols` row join, so a hit with no enclosing symbol\n(`kind=\"file\"` path hits, `kind=\"grep\"` matches outside any symbol\nbody, gap-chunk semantic hits) has neither.",
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "line_start": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "line_end": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "match_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "snippet": {
            "description": "`kind=\"grep\"` only: the matched line with `context` lines of\nsurrounding text, 1-indexed and marked.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "path"
        ]
      },
      "SymbolInfoOutput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "qualified_name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "format": "int64"
          },
          "line_end": {
            "type": "integer",
            "format": "int64"
          },
          "signature": {
            "type": [
              "string",
              "null"
            ]
          },
          "docstring": {
            "type": [
              "string",
              "null"
            ]
          },
          "caller_count": {
            "type": "integer",
            "format": "int64"
          },
          "is_hub": {
            "type": "boolean"
          },
          "coreness": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "health": {
            "anyOf": [
              {
                "$ref": "#/$defs/HealthOutput"
              },
              {
                "type": "null"
              }
            ]
          },
          "suggested_next": {
            "anyOf": [
              {
                "$ref": "#/$defs/SuggestedNext"
              },
              {
                "type": "null"
              }
            ]
          },
          "type_relations": {
            "description": "Tier 1 semantic facts (2026-08-07 roadmap T1) — `extends`/\n`implements` extracted directly from syntax. `None` (not an empty\narray) when this symbol has no relations, so a caller can tell\n\"checked, has none\" apart from \"not populated\" if that distinction\never matters. See `indexer::semantic_facts` for exactly what's\ncaptured per language and why some things are deliberately absent.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/$defs/TypeRelationOutput"
            }
          },
          "effects": {
            "description": "Tier 1 semantic facts, effect half — explicit throws and direct\nself/this-field writes. Same \"None means none found\" contract as\n`type_relations` above.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/$defs/EffectOutput"
            }
          },
          "content_warning": {
            "description": "P2 (docs/plans/2026-08-08-derived-artifact-hardening-execution-plan.md):\nset when any `type_relations`/`effects` `target_text`/`to_symbol`\nabove looks injection-shaped -- same trust boundary `source`'s\n`content_warning` covers, applied to syntax-derived facts instead of\na raw file body. Text itself is never mutated.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "qualified_name",
          "kind",
          "path",
          "line_start",
          "line_end",
          "caller_count",
          "is_hub"
        ]
      },
      "HealthOutput": {
        "type": "object",
        "properties": {
          "dead_code_confidence": {
            "type": "string"
          },
          "dead_code_source": {
            "type": "string"
          },
          "caller_count_by_confidence": {
            "anyOf": [
              {
                "$ref": "#/$defs/CallerCountByConfidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "test_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "dead_code_confidence",
          "dead_code_source",
          "test_files"
        ]
      },
      "CallerCountByConfidence": {
        "type": "object",
        "properties": {
          "formal": {
            "type": "integer",
            "format": "int64"
          },
          "resolved": {
            "type": "integer",
            "format": "int64"
          },
          "inferred": {
            "type": "integer",
            "format": "int64"
          },
          "textual": {
            "type": "integer",
            "format": "int64"
          },
          "ambiguous": {
            "description": "Bare-name matches fanned out across >1 same-named candidate with no\ntie-breaker — most likely correct for at most one of them. See\n`EdgeConfidence::Ambiguous`.",
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "formal",
          "resolved",
          "inferred",
          "textual",
          "ambiguous"
        ]
      },
      "TypeRelationOutput": {
        "type": "object",
        "properties": {
          "relation_kind": {
            "type": "string"
          },
          "target_text": {
            "type": "string"
          },
          "to_symbol": {
            "description": "Populated only when `target_text` resolved to a real symbol in the\nSAME file (v1 has no cross-file global resolution pass yet — see\n`db::schema`'s `type_relations` table comment). `confidence` drops\nto `\"textual\"`, not an error, when this is `None`.",
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "string"
          }
        },
        "required": [
          "relation_kind",
          "target_text",
          "confidence"
        ]
      },
      "EffectOutput": {
        "type": "object",
        "properties": {
          "effect_kind": {
            "type": "string"
          },
          "target_text": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "format": "int64"
          },
          "event_confidence": {
            "description": "P3 (docs/plans/2026-08-08-derived-artifact-hardening-execution-plan.md):\ncertainty THAT the effect happened -- currently always `\"exact\"`\n(every extraction site fires only on a real syntactic raise/throw/\nwrite node); kept as its own field for forward compatibility rather\nthan folded into `target_confidence`, which is a DIFFERENT question\n(certainty about WHAT the target is).",
            "type": "string"
          },
          "target_confidence": {
            "description": "`\"exact\"` | `\"none\"` -- certainty about what `target_text` names.\n`\"none\"` means the effect definitely happened but the exact target\ncouldn't be determined syntactically (e.g. Python `raise e` where\n`e` is a caught-exception variable, not a resolvable type) -- the\ntext is still the real syntax that was there, just not resolved.",
            "type": "string"
          }
        },
        "required": [
          "effect_kind",
          "target_text",
          "line",
          "event_confidence",
          "target_confidence"
        ]
      },
      "FileOverviewOutput": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "symbols": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/FileOverviewSymbol"
            }
          },
          "symbol_count": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "symbols_truncated": {
            "description": "`true` when `symbols` was capped below `symbol_count` (only `locate`\ncaps; the `file_overview` tool always returns the full list).",
            "type": "boolean"
          },
          "suggested_next": {
            "anyOf": [
              {
                "$ref": "#/$defs/SuggestedNext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "symbols",
          "symbol_count",
          "symbols_truncated"
        ]
      },
      "FileOverviewSymbol": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "qualified_name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "format": "int64"
          },
          "line_end": {
            "type": "integer",
            "format": "int64"
          },
          "caller_count": {
            "type": "integer",
            "format": "int64"
          },
          "is_hub": {
            "type": "boolean"
          },
          "signature": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "qualified_name",
          "kind",
          "line_start",
          "line_end",
          "caller_count",
          "is_hub",
          "signature"
        ]
      },
      "RelatedNoteOutput": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "excerpt": {
            "description": "First 160 characters of the note's content — not the full note;\ncall `recall(topic=...)` for the whole thing.",
            "type": "string"
          },
          "specificity": {
            "description": "`\"symbol\"` when the note's text mentions the resolved symbol's bare\nname (higher trust), `\"file\"` when it only matched at file level\n(the note references this file but may be about a different symbol\nin it — calibrate trust accordingly).",
            "type": "string"
          },
          "staleness": {
            "description": "`\"fresh\"` / `\"stale\"` / `\"gone\"` (same convention as `recall`'s\nper-note staleness) / `\"unknown\"` when the staleness check itself\nfailed (fail-open: the note still surfaces, just without a\nconfident freshness read).",
            "type": "string"
          }
        },
        "required": [
          "topic",
          "excerpt",
          "specificity",
          "staleness"
        ]
      }
    },
    "required": [
      "flow_state"
    ],
    "type": "object",
    "properties": {
      "flow_state": {
        "description": "Wave 11 (item 3, \"unified continuation state machine\"): present on\nevery response regardless of success/error -- `\"ready\"` on success,\nor one of `needs_context`/`needs_human_review`/`needs_verification`/\n`blocked` on error (see `classify_error_state`'s own doc comment).\nLets an agent dispatch on ONE top-level field instead of\nmaintaining its own per-`code` remediation table across ~70\ndistinct codes.\n\nNamed `flow_state`, not the more obvious `state` (audit follow-up,\n2026-08-23): several tool-specific success structs (e.g.\n`EditTransactionStatusOutput`, `VerifyChangeOutput` in txn.rs) have\ntheir own unrelated `state` field, and this struct's `success: T` is\n`#[serde(flatten)]`ed -- a same-named field there would silently\nserialize as a SECOND `\"state\"` JSON key (serde's flatten writes\neach field independently; nothing dedupes it), with most JSON\nparsers then last-write-wins-ing over whichever value serialized\nsecond. `flow_state` is deliberately namespaced so no domain output\nstruct will ever pick the same name by coincidence again.",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ErrorDetail"
          },
          {
            "type": "null"
          }
        ]
      },
      "results": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SearchResultItem"
        }
      },
      "top_symbol": {
        "anyOf": [
          {
            "$ref": "#/$defs/SymbolInfoOutput"
          },
          {
            "type": "null"
          }
        ]
      },
      "file_overview": {
        "anyOf": [
          {
            "$ref": "#/$defs/FileOverviewOutput"
          },
          {
            "type": "null"
          }
        ]
      },
      "truncated": {
        "type": "boolean"
      },
      "depth_adjusted": {
        "description": "Set when the requested `depth` was auto-downgraded — see\n`CONTRACTS.md`'s `LocateDepth` invariant: `kind ∈ {text, file}` +\n`depth = with_symbol` has no meaningful symbol to enrich, so it's\ndowngraded to `with_file`.",
        "type": [
          "string",
          "null"
        ]
      },
      "personalized": {
        "description": "See `SearchOutput::personalized`.",
        "type": "boolean"
      },
      "related_notes": {
        "description": "Notes saved via `remember` that reference `top_symbol`'s file. Empty\nwhen there's no top_symbol (search_only/with_file depth, or no\nresults) or simply no matching notes — not an error signal. See\n`CalmServer::related_notes` for the specificity/fail-open/content-\nsafety rules governing what qualifies.",
        "type": "array",
        "items": {
          "$ref": "#/$defs/RelatedNoteOutput"
        }
      },
      "suggested_next": {
        "anyOf": [
          {
            "$ref": "#/$defs/SuggestedNext"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
