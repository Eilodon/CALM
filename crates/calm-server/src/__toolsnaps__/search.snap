{
  "name": "search",
  "description": "USE THIS INSTEAD OF native grep, text search, or file browsing tools. USE WHEN: you don't have an exact file path and line number. kind=hybrid has highest recall. NOT FOR: inspecting a file you already have (use file_overview). vs locate: search returns a result list; locate returns search + symbol metadata in one call.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "query"
    ],
    "type": "object",
    "properties": {
      "query": {
        "description": "Free-text query. Required for every `kind` except `\"similar\"`, where\nit's ignored — pass `path`+`line` instead (an anchor location has no\ntext query to embed; its own stored chunk vector is reused as-is).",
        "type": "string"
      },
      "kind": {
        "description": "One of `\"symbol\"` (name/signature match), `\"text\"` (FTS over\nname/docstring/signature AND function bodies, 3.2 Wave 3 — still\ndoes NOT cover imports or non-code files; use `\"grep\"` for those),\n`\"file\"` (path\nmatch — glob syntax like `*.md` or\n`src/**` also works, otherwise plain substring), `\"grep\"` (real\nregex over raw file content read from disk, including files the\nindexer never parses — Cargo.toml, docs/*.md, etc.; see `glob`/\n`case_insensitive`/`context`), `\"semantic\"` (embedding KNN — needs\nthe `embeddings` feature and a ready index), `\"hybrid\"` (default —\nRRF fusion of text + symbol-identity + code-chunk vectors; degrades\ngracefully to plain `\"symbol\"` behavior when no embedder is\nconfigured, see `degraded`/`note`), or `\"similar\"` (embedding KNN\nanchored at `path`+`line` instead of a text query — \"find code that\nlooks like *this location*\", not \"find code matching these words\";\nneeds `embeddings` and `path`+`line`). Any other value silently\nfalls back to `\"symbol\"`.",
        "type": "string",
        "default": "hybrid"
      },
      "limit": {
        "description": "Max results to return. Default 10.",
        "type": "integer",
        "format": "uint",
        "minimum": 0,
        "default": 10
      },
      "glob": {
        "description": "`kind=\"grep\"` only: `query` is treated as a regex pattern by default\n— set this to a glob (e.g. `\"*.rs\"`, `\"docs/**\"`) to restrict which\nfiles are scanned.",
        "type": [
          "string",
          "null"
        ]
      },
      "case_insensitive": {
        "description": "`kind=\"grep\"` only: case-insensitive regex match. Default `false`.",
        "type": "boolean",
        "default": false
      },
      "context": {
        "description": "`kind=\"grep\"` only: number of context lines shown before/after each\nmatch in the returned snippet. Default 0.",
        "type": "integer",
        "format": "uint",
        "minimum": 0,
        "default": 0
      },
      "path": {
        "description": "`kind=\"similar\"` only, required: repo-relative path of the anchor\nlocation whose code you want to find elsewhere in the repo.",
        "type": [
          "string",
          "null"
        ]
      },
      "line": {
        "description": "`kind=\"similar\"` only, required: 1-indexed line within `path` that\nselects the anchor chunk (the smallest indexed chunk spanning this\nline).",
        "type": [
          "integer",
          "null"
        ],
        "format": "int64"
      },
      "include_tests": {
        "description": "`false` to hard-exclude test code (`is_test`) from results. Default\n`true` (current behavior, unchanged): tests are only soft-penalized\nvia `NOISE_PENALTY`, which a descriptively-named test that closely\nparaphrases the query can still outrank the real implementation\nagainst — pass `false` when the query has nothing to do with tests\nto exclude them outright instead of just down-ranking them. May\nreturn fewer than `limit` results if enough hits were tests (a\nmodest overfetch covers most cases but isn't retried further).",
        "type": "boolean",
        "default": true
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          },
          "review": {
            "description": "Set only on HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW / DIFF_DIGEST_MISMATCH — everything needed to relay-approve/decline via review_decide_via_agent_relay.",
            "anyOf": [
              {
                "$ref": "#/$defs/PendingReviewPacket"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_call": {
            "description": "The exact next tool call this error implies, if unambiguous — same shape as suggested_next.",
            "anyOf": [
              {
                "$ref": "#/$defs/SuggestedNext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "recoverable"
        ]
      },
      "PendingReviewPacket": {
        "description": "Wave 3 (audit follow-up, 2026-08-23): the structured shape of a\n`HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW`/`DIFF_DIGEST_MISMATCH` error's\n`review` field -- lets a calling agent relay-approve/decline without\never reading `pending_reviews` directly or reimplementing\n`hash_content` itself.\n\nWave 14 (audit follow-up, 2026-08-24): `diff_digest` is NOT\n`hash_content` of THIS packet's own `diff_preview` field -- it's\n`hash_content` of the full, unsanitized, uncapped diff stored server-\nside (see `from_pending`'s own comment). It exists to prove identity/\nfreshness (\"this is really the review you fetched, not a stale or\nguessed copy\"), not to let a caller verify \"the text I'm looking at\nhashes to this\" -- that's structurally impossible to guarantee anyway,\nsince different surfaces (this JSON packet vs. `calm review show`'s\nterminal output) apply different sanitize/cap transforms to the same\nunderlying diff and can't all match one digest. Callers must always\nCOPY this value verbatim, never recompute it from `diff_preview`.",
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string"
          },
          "diff_preview": {
            "type": "string"
          },
          "preview_truncated": {
            "description": "`true` when `diff_preview` was cut down from the full diff\n`diff_digest` covers -- see the struct's own doc comment.",
            "type": "boolean"
          },
          "diff_digest": {
            "type": "string"
          },
          "expires_at": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "review_id",
          "diff_preview",
          "preview_truncated",
          "diff_digest",
          "expires_at"
        ]
      },
      "SuggestedNext": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "args": true,
          "gate": {
            "description": "true iff skipping `tool` is hook-enforced, not just advisory.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "required_user_input": {
            "description": "Names any `tool` param intentionally left out of `args` because only a human can safely supply it (e.g. `approve`). Absent means `args` is already complete.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "tool",
          "reason"
        ]
      },
      "SearchResultItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "qualified_name": {
            "description": "3.4 (Wave 3, P1-3): the symbol's exact `qualified_name`, restored\nafter being dropped from this output type -- feed it straight into\n`source`/`symbol_info`/`callers`/`callees`/`reference_impact`/`path`/\n`pattern_debt_register`'s new `qualified_name` param to resolve by\nidentity, never `Ambiguous`, even for a globally-common bare name.\nPresent only when `kind` is also present -- both are populated from\nthe same live `symbols` row join, so a hit with no enclosing symbol\n(`kind=\"file\"` path hits, `kind=\"grep\"` matches outside any symbol\nbody, gap-chunk semantic hits) has neither.",
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "line_start": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "line_end": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "match_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "snippet": {
            "description": "`kind=\"grep\"` only: the matched line with `context` lines of\nsurrounding text, 1-indexed and marked.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "path"
        ]
      }
    },
    "required": [
      "flow_state"
    ],
    "type": "object",
    "properties": {
      "flow_state": {
        "description": "Wave 11 (item 3, \"unified continuation state machine\"): present on\nevery response regardless of success/error -- `\"ready\"` on success,\nor one of `needs_context`/`needs_human_review`/`needs_verification`/\n`blocked` on error (see `classify_error_state`'s own doc comment).\nLets an agent dispatch on ONE top-level field instead of\nmaintaining its own per-`code` remediation table across ~70\ndistinct codes.\n\nNamed `flow_state`, not the more obvious `state` (audit follow-up,\n2026-08-23): several tool-specific success structs (e.g.\n`EditTransactionStatusOutput`, `VerifyChangeOutput` in txn.rs) have\ntheir own unrelated `state` field, and this struct's `success: T` is\n`#[serde(flatten)]`ed -- a same-named field there would silently\nserialize as a SECOND `\"state\"` JSON key (serde's flatten writes\neach field independently; nothing dedupes it), with most JSON\nparsers then last-write-wins-ing over whichever value serialized\nsecond. `flow_state` is deliberately namespaced so no domain output\nstruct will ever pick the same name by coincidence again.",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ErrorDetail"
          },
          {
            "type": "null"
          }
        ]
      },
      "results": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SearchResultItem"
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "degraded": {
        "type": "boolean"
      },
      "note": {
        "type": [
          "string",
          "null"
        ]
      },
      "personalized": {
        "description": "`true` when results were re-ranked toward this session's explored\nfiles/symbols (see `CalmServer::apply_personalization_boost`)\n— `false` for a cold session (nothing explored yet) or when\n`search.personalization_weight` is configured to `0.0`.",
        "type": "boolean"
      },
      "suggested_next": {
        "anyOf": [
          {
            "$ref": "#/$defs/SuggestedNext"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
