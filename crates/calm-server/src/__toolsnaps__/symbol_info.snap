{
  "name": "symbol_info",
  "description": "USE WHEN: you have a symbol name and want metadata + health signals BEFORE reading source. Check is_hub + coreness before deciding whether to modify — hub symbols need edit_context. NOT FOR: reading source (use source), finding symbols (use search/locate). vs source: symbol_info is metadata-only (no code body).",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "symbol"
    ],
    "type": "object",
    "properties": {
      "symbol": {
        "description": "Bare symbol name (not a `path::name` qualified name).",
        "type": "string"
      },
      "path": {
        "description": "Narrows the search to one file when `symbol` alone is ambiguous\nacross the repo. Repo-relative path.",
        "type": [
          "string",
          "null"
        ]
      },
      "line": {
        "description": "Disambiguates same-named symbols in the same file — any line within\nthe intended candidate's range (see an earlier `ambiguous` response's\n`line_start`/`line_end`).",
        "type": [
          "integer",
          "null"
        ],
        "format": "int64"
      },
      "qualified_name": {
        "description": "3.4 (Wave 3): exact `qualified_name` from a prior `search`/`locate`\nresult -- when set, resolves directly by identity and `path`/`line`\nare ignored, so this can never come back ambiguous even for a\nglobally-common bare `symbol` name.",
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          },
          "review": {
            "description": "Set only on HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW / DIFF_DIGEST_MISMATCH — everything needed to relay-approve/decline via review_decide_via_agent_relay.",
            "anyOf": [
              {
                "$ref": "#/$defs/PendingReviewPacket"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_call": {
            "description": "The exact next tool call this error implies, if unambiguous — same shape as suggested_next.",
            "anyOf": [
              {
                "$ref": "#/$defs/SuggestedNext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "recoverable"
        ]
      },
      "PendingReviewPacket": {
        "description": "Wave 3 (audit follow-up, 2026-08-23): the structured shape of a\n`HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW`/`DIFF_DIGEST_MISMATCH` error's\n`review` field -- lets a calling agent relay-approve/decline without\never reading `pending_reviews` directly or reimplementing\n`hash_content` itself. `diff_digest` is always `hash_content(&diff_preview)`,\ncomputed server-side at the moment this packet is built -- never a\nvalue the caller supplied or guessed.",
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string"
          },
          "diff_preview": {
            "type": "string"
          },
          "diff_digest": {
            "type": "string"
          },
          "expires_at": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "review_id",
          "diff_preview",
          "diff_digest",
          "expires_at"
        ]
      },
      "SuggestedNext": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "args": true,
          "gate": {
            "description": "true iff skipping `tool` is hook-enforced, not just advisory.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "required_user_input": {
            "description": "Names any `tool` param intentionally left out of `args` because only a human can safely supply it (e.g. `approve`). Absent means `args` is already complete.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "tool",
          "reason"
        ]
      },
      "AmbiguousCandidate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "format": "int64"
          },
          "line_end": {
            "type": "integer",
            "format": "int64"
          },
          "class_context": {
            "type": [
              "string",
              "null"
            ]
          },
          "caller_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "signature": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "path",
          "kind",
          "line_start",
          "line_end"
        ]
      },
      "HealthOutput": {
        "type": "object",
        "properties": {
          "dead_code_confidence": {
            "type": "string"
          },
          "dead_code_source": {
            "type": "string"
          },
          "caller_count_by_confidence": {
            "anyOf": [
              {
                "$ref": "#/$defs/CallerCountByConfidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "test_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "dead_code_confidence",
          "dead_code_source",
          "test_files"
        ]
      },
      "CallerCountByConfidence": {
        "type": "object",
        "properties": {
          "formal": {
            "type": "integer",
            "format": "int64"
          },
          "resolved": {
            "type": "integer",
            "format": "int64"
          },
          "inferred": {
            "type": "integer",
            "format": "int64"
          },
          "textual": {
            "type": "integer",
            "format": "int64"
          },
          "ambiguous": {
            "description": "Bare-name matches fanned out across >1 same-named candidate with no\ntie-breaker — most likely correct for at most one of them. See\n`EdgeConfidence::Ambiguous`.",
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "formal",
          "resolved",
          "inferred",
          "textual",
          "ambiguous"
        ]
      },
      "TypeRelationOutput": {
        "type": "object",
        "properties": {
          "relation_kind": {
            "type": "string"
          },
          "target_text": {
            "type": "string"
          },
          "to_symbol": {
            "description": "Populated only when `target_text` resolved to a real symbol in the\nSAME file (v1 has no cross-file global resolution pass yet — see\n`db::schema`'s `type_relations` table comment). `confidence` drops\nto `\"textual\"`, not an error, when this is `None`.",
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "string"
          }
        },
        "required": [
          "relation_kind",
          "target_text",
          "confidence"
        ]
      },
      "EffectOutput": {
        "type": "object",
        "properties": {
          "effect_kind": {
            "type": "string"
          },
          "target_text": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "format": "int64"
          },
          "event_confidence": {
            "description": "P3 (docs/plans/2026-08-08-derived-artifact-hardening-execution-plan.md):\ncertainty THAT the effect happened -- currently always `\"exact\"`\n(every extraction site fires only on a real syntactic raise/throw/\nwrite node); kept as its own field for forward compatibility rather\nthan folded into `target_confidence`, which is a DIFFERENT question\n(certainty about WHAT the target is).",
            "type": "string"
          },
          "target_confidence": {
            "description": "`\"exact\"` | `\"none\"` -- certainty about what `target_text` names.\n`\"none\"` means the effect definitely happened but the exact target\ncouldn't be determined syntactically (e.g. Python `raise e` where\n`e` is a caught-exception variable, not a resolvable type) -- the\ntext is still the real syntax that was there, just not resolved.",
            "type": "string"
          }
        },
        "required": [
          "effect_kind",
          "target_text",
          "line",
          "event_confidence",
          "target_confidence"
        ]
      },
      "Caveat": {
        "description": "Structured, machine-checkable hint attached to a tool result whose\nliteral content (empty list / not-found) could otherwise be misread as\nproof of absence. `class` lets a safety gate branch without parsing\n`message`; `message` is the human-readable explanation. Design mirrors\nzzet/gortex's `ZeroEdgeCaveat` (Apache-2.0) — reimplemented against\nCALM's own resolver shape, not a line-for-line port.",
        "type": "object",
        "properties": {
          "class": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "class",
          "message"
        ]
      }
    },
    "required": [
      "flow_state"
    ],
    "type": "object",
    "properties": {
      "flow_state": {
        "description": "See `ToolOutcome::flow_state`'s own doc comment -- same contract\n(including why it's named `flow_state`, not `state`), plus\n`ambiguous`/`not_found` both map onto `needs_context` (the caller\nneeds one more piece of information: which candidate, or a\ndifferent query).",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ErrorDetail"
          },
          {
            "type": "null"
          }
        ]
      },
      "ambiguous": {
        "type": "boolean"
      },
      "total": {
        "description": "Total candidates matched before the display cap of\n`MAX_AMBIGUOUS_CANDIDATES`. `truncated` is `true` when `total >\ncandidates.len()`, telling the caller there are more matches than\nshown and to narrow with `path`/`line` — the list is never silently\npresented as the complete set.",
        "type": "integer",
        "format": "uint",
        "minimum": 0
      },
      "truncated": {
        "type": "boolean"
      },
      "candidates": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/AmbiguousCandidate"
        }
      },
      "name": {
        "type": "string"
      },
      "qualified_name": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "line_start": {
        "type": "integer",
        "format": "int64"
      },
      "line_end": {
        "type": "integer",
        "format": "int64"
      },
      "signature": {
        "type": [
          "string",
          "null"
        ]
      },
      "docstring": {
        "type": [
          "string",
          "null"
        ]
      },
      "caller_count": {
        "type": "integer",
        "format": "int64"
      },
      "is_hub": {
        "type": "boolean"
      },
      "coreness": {
        "type": [
          "integer",
          "null"
        ],
        "format": "int64"
      },
      "health": {
        "anyOf": [
          {
            "$ref": "#/$defs/HealthOutput"
          },
          {
            "type": "null"
          }
        ]
      },
      "suggested_next": {
        "anyOf": [
          {
            "$ref": "#/$defs/SuggestedNext"
          },
          {
            "type": "null"
          }
        ]
      },
      "type_relations": {
        "description": "Tier 1 semantic facts (2026-08-07 roadmap T1) — `extends`/\n`implements` extracted directly from syntax. `None` (not an empty\narray) when this symbol has no relations, so a caller can tell\n\"checked, has none\" apart from \"not populated\" if that distinction\never matters. See `indexer::semantic_facts` for exactly what's\ncaptured per language and why some things are deliberately absent.",
        "type": [
          "array",
          "null"
        ],
        "items": {
          "$ref": "#/$defs/TypeRelationOutput"
        }
      },
      "effects": {
        "description": "Tier 1 semantic facts, effect half — explicit throws and direct\nself/this-field writes. Same \"None means none found\" contract as\n`type_relations` above.",
        "type": [
          "array",
          "null"
        ],
        "items": {
          "$ref": "#/$defs/EffectOutput"
        }
      },
      "content_warning": {
        "description": "P2 (docs/plans/2026-08-08-derived-artifact-hardening-execution-plan.md):\nset when any `type_relations`/`effects` `target_text`/`to_symbol`\nabove looks injection-shaped -- same trust boundary `source`'s\n`content_warning` covers, applied to syntax-derived facts instead of\na raw file body. Text itself is never mutated.",
        "type": [
          "string",
          "null"
        ]
      },
      "caveat": {
        "description": "Advisory hint on an empty/not-found result. Never set alongside a\npopulated `success` unless a tool opts in via `with_caveat` (e.g.\n`callers` on zero direct callers).",
        "anyOf": [
          {
            "$ref": "#/$defs/Caveat"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
