{
  "name": "pattern_debt_status",
  "description": "Re-check registered pattern-debt anchor(s): re-resolves each anchor's current location by qualified_name (never a stale line number) and re-runs search(kind=\"similar\") to report how many similar instances remain. Pass `topic` for one anchor (the value pattern_debt_register returned), or omit to check every OPEN anchor (capped — see truncated). status is one of: open (similar instances still found), resolved (none found this check — persisted), anchor_lost (the symbol was renamed/removed/split since registration — never silently reported as resolved). USE WHEN: verifying whether a duplicated bug pattern you registered earlier has actually been cleaned up elsewhere, or auditing outstanding pattern debt. Read-only towards your code; does update this anchor's own tracked status/last-checked fields.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "topic": {
        "description": "Check one anchor by its topic (from `pattern_debt_register`'s\noutput). Omit to check every currently-`open` anchor instead\n(capped — see the output's `truncated`).",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          },
          "review": {
            "description": "Set only on HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW / DIFF_DIGEST_MISMATCH — everything needed to relay-approve/decline via review_decide_via_agent_relay.",
            "anyOf": [
              {
                "$ref": "#/$defs/PendingReviewPacket"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_call": {
            "description": "The exact next tool call this error implies, if unambiguous — same shape as suggested_next.",
            "anyOf": [
              {
                "$ref": "#/$defs/SuggestedNext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "recoverable"
        ]
      },
      "PendingReviewPacket": {
        "description": "Wave 3 (audit follow-up, 2026-08-23): the structured shape of a\n`HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW`/`DIFF_DIGEST_MISMATCH` error's\n`review` field -- lets a calling agent relay-approve/decline without\never reading `pending_reviews` directly or reimplementing\n`hash_content` itself.\n\nWave 14 (audit follow-up, 2026-08-24): `diff_digest` is NOT\n`hash_content` of THIS packet's own `diff_preview` field -- it's\n`hash_content` of the full, unsanitized, uncapped diff stored server-\nside (see `from_pending`'s own comment). It exists to prove identity/\nfreshness (\"this is really the review you fetched, not a stale or\nguessed copy\"), not to let a caller verify \"the text I'm looking at\nhashes to this\" -- that's structurally impossible to guarantee anyway,\nsince different surfaces (this JSON packet vs. `calm review show`'s\nterminal output) apply different sanitize/cap transforms to the same\nunderlying diff and can't all match one digest. Callers must always\nCOPY this value verbatim, never recompute it from `diff_preview`.",
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string"
          },
          "diff_preview": {
            "type": "string"
          },
          "preview_truncated": {
            "description": "`true` when `diff_preview` was cut down from the full diff\n`diff_digest` covers -- see the struct's own doc comment.",
            "type": "boolean"
          },
          "diff_digest": {
            "type": "string"
          },
          "expires_at": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "review_id",
          "diff_preview",
          "preview_truncated",
          "diff_digest",
          "expires_at"
        ]
      },
      "SuggestedNext": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "args": true,
          "gate": {
            "description": "true iff skipping `tool` is hook-enforced, not just advisory.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "required_user_input": {
            "description": "Names any `tool` param intentionally left out of `args` because only a human can safely supply it (e.g. `approve`). Absent means `args` is already complete.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "tool",
          "reason"
        ]
      },
      "PatternDebtEntryOutput": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "anchor_qualified_name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "baseline_count": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "description": "One of `open` / `resolved` / `anchor_lost`, or a `\"<status>\n(check_unavailable_this_run)\"` suffix when this check couldn't run\n(e.g. embeddings not ready) — the persisted status shown is what it\nwas *before* this call, never guessed.",
            "type": "string"
          },
          "current_count": {
            "description": "Similar-instance count from this check (excludes the anchor itself).\n`None` when the anchor is lost or this check was unavailable.",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "remaining_locations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/PatternDebtLocationOutput"
            }
          },
          "checked_at": {
            "type": "string"
          }
        },
        "required": [
          "topic",
          "anchor_qualified_name",
          "note",
          "baseline_count",
          "status",
          "remaining_locations",
          "checked_at"
        ]
      },
      "PatternDebtLocationOutput": {
        "type": "object",
        "properties": {
          "qualified_name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line_start": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "score": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "qualified_name",
          "path",
          "score"
        ]
      }
    },
    "required": [
      "flow_state"
    ],
    "type": "object",
    "properties": {
      "flow_state": {
        "description": "Wave 11 (item 3, \"unified continuation state machine\"): present on\nevery response regardless of success/error -- `\"ready\"` on success,\nor one of `needs_context`/`needs_human_review`/`needs_verification`/\n`blocked` on error (see `classify_error_state`'s own doc comment).\nLets an agent dispatch on ONE top-level field instead of\nmaintaining its own per-`code` remediation table across ~70\ndistinct codes.\n\nNamed `flow_state`, not the more obvious `state` (audit follow-up,\n2026-08-23): several tool-specific success structs (e.g.\n`EditTransactionStatusOutput`, `VerifyChangeOutput` in txn.rs) have\ntheir own unrelated `state` field, and this struct's `success: T` is\n`#[serde(flatten)]`ed -- a same-named field there would silently\nserialize as a SECOND `\"state\"` JSON key (serde's flatten writes\neach field independently; nothing dedupes it), with most JSON\nparsers then last-write-wins-ing over whichever value serialized\nsecond. `flow_state` is deliberately namespaced so no domain output\nstruct will ever pick the same name by coincidence again.",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ErrorDetail"
          },
          {
            "type": "null"
          }
        ]
      },
      "entries": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/PatternDebtEntryOutput"
        }
      },
      "truncated": {
        "description": "`true` when more than `PATTERN_DEBT_STATUS_MAX` open entries exist —\nre-run with an explicit `topic` to check the rest.",
        "type": "boolean"
      },
      "suggested_next": {
        "anyOf": [
          {
            "$ref": "#/$defs/SuggestedNext"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
