{
  "name": "dependencies",
  "description": "USE WHEN: you need to understand file-level architectural connections. USE THIS for FILE-LEVEL import graph. NOT for symbol-level call sites (use callers/callees). vs callers/callees: dependencies is file-level; callers/callees is symbol-level.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "path"
    ],
    "type": "object",
    "properties": {
      "path": {
        "description": "Repo-relative path of the file whose imports/importers to list, e.g.\n`crates/calm-core/src/embedding.rs`.",
        "type": "string"
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          },
          "review": {
            "description": "Set only on HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW / DIFF_DIGEST_MISMATCH — everything needed to relay-approve/decline via review_decide_via_agent_relay.",
            "anyOf": [
              {
                "$ref": "#/$defs/PendingReviewPacket"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_call": {
            "description": "The exact next tool call this error implies, if unambiguous — same shape as suggested_next.",
            "anyOf": [
              {
                "$ref": "#/$defs/SuggestedNext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "recoverable"
        ]
      },
      "PendingReviewPacket": {
        "description": "Wave 3 (audit follow-up, 2026-08-23): the structured shape of a\n`HIGH_RISK_REQUIRES_INDEPENDENT_REVIEW`/`DIFF_DIGEST_MISMATCH` error's\n`review` field -- lets a calling agent relay-approve/decline without\never reading `pending_reviews` directly or reimplementing\n`hash_content` itself. `diff_digest` is always `hash_content(&diff_preview)`,\ncomputed server-side at the moment this packet is built -- never a\nvalue the caller supplied or guessed.",
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string"
          },
          "diff_preview": {
            "type": "string"
          },
          "diff_digest": {
            "type": "string"
          },
          "expires_at": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "review_id",
          "diff_preview",
          "diff_digest",
          "expires_at"
        ]
      },
      "SuggestedNext": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "args": true,
          "gate": {
            "description": "true iff skipping `tool` is hook-enforced, not just advisory.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "required_user_input": {
            "description": "Names any `tool` param intentionally left out of `args` because only a human can safely supply it (e.g. `approve`). Absent means `args` is already complete.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "tool",
          "reason"
        ]
      },
      "ImportEntry": {
        "type": "object",
        "properties": {
          "from_path": {
            "type": "string"
          },
          "to_path": {
            "type": "string"
          },
          "module_name": {
            "type": "string"
          },
          "symbols_used": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "from_path",
          "to_path",
          "module_name",
          "symbols_used"
        ]
      }
    },
    "required": [
      "flow_state"
    ],
    "type": "object",
    "properties": {
      "flow_state": {
        "description": "Wave 11 (item 3, \"unified continuation state machine\"): present on\nevery response regardless of success/error -- `\"ready\"` on success,\nor one of `needs_context`/`needs_human_review`/`needs_verification`/\n`blocked` on error (see `classify_error_state`'s own doc comment).\nLets an agent dispatch on ONE top-level field instead of\nmaintaining its own per-`code` remediation table across ~70\ndistinct codes.\n\nNamed `flow_state`, not the more obvious `state` (audit follow-up,\n2026-08-23): several tool-specific success structs (e.g.\n`EditTransactionStatusOutput`, `VerifyChangeOutput` in txn.rs) have\ntheir own unrelated `state` field, and this struct's `success: T` is\n`#[serde(flatten)]`ed -- a same-named field there would silently\nserialize as a SECOND `\"state\"` JSON key (serde's flatten writes\neach field independently; nothing dedupes it), with most JSON\nparsers then last-write-wins-ing over whichever value serialized\nsecond. `flow_state` is deliberately namespaced so no domain output\nstruct will ever pick the same name by coincidence again.",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ErrorDetail"
          },
          {
            "type": "null"
          }
        ]
      },
      "path": {
        "type": "string"
      },
      "imports": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/ImportEntry"
        }
      },
      "imports_truncated": {
        "type": "boolean"
      },
      "imported_by": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/ImportEntry"
        }
      },
      "imported_by_truncated": {
        "type": "boolean"
      },
      "call_dependents": {
        "description": "Files that reference this file via call edges but are absent from\n`imported_by` — e.g. a fully-qualified `crate::foo::Bar::baz()` call\nwith no `use`. Best-effort (can include ambiguous-receiver calls);\ncomplements the import graph, does not replace it.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "glob_reexport_dependents": {
        "description": "Files that reach this file's symbols through exactly one `use other::*;`\nhop — see the doc comment where this is computed in `dependencies`.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "suggested_next": {
        "anyOf": [
          {
            "$ref": "#/$defs/SuggestedNext"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
