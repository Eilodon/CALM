{
  "name": "indexing_status",
  "description": "USE WHEN: you need file-level index stats, embedding error details, or to trigger embedding recovery. NOT a replacement for repo_overview at session start. retry_embeddings=true triggers re-download of embedding model.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "retry_embeddings": {
        "description": "`true` to re-attempt loading the embedding model and re-embedding,\nbut only if the current `embeddings_status` is `\"failed\"` or\n`\"offline_unavailable\"` — a no-op otherwise (already succeeded, or\nalready in progress).",
        "type": "boolean",
        "default": false
      }
    },
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "recoverable"
        ]
      },
      "SkippedFilesStatusOutput": {
        "description": "Files currently carrying a `file_index.skip_reason` (4.1b). `entries` is\ncapped at `SKIPPED_FILES_STATUS_CAP`; `total` is the true count even when\ntruncated -- same cap-with-true-count contract `callers`/`callees`\nalready use for their own direct-caller/callee lists. A file that reads\nsuccessfully on its next pass has its row's `skip_reason` cleared back\nto `NULL` (see `discovery::upsert_file_index`'s doc comment) and drops\nout of this list on its own, with no separate cleanup step needed.",
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/SkippedFileEntryOutput"
            }
          }
        },
        "required": [
          "total",
          "entries"
        ]
      },
      "SkippedFileEntryOutput": {
        "description": "One `file_index` row with a recorded `skip_reason` (4.1b, truth-kernel-\nhardening plan) -- couldn't be read on its most recent reindex pass\n(too large, unreadable, permission denied, a non-UTF-8 write\nmid-flight), so nothing was extracted/re-extracted for it that pass.",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "skip_reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "skip_reason"
        ]
      },
      "ExternalProofStatusOutput": {
        "type": "object",
        "properties": {
          "fresh": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "stale": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "legacy": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "unverified": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "rejected": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "fresh",
          "stale",
          "legacy",
          "unverified",
          "rejected"
        ]
      },
      "SemanticFactsStatusOutput": {
        "type": "object",
        "properties": {
          "type_relations_total": {
            "type": "integer",
            "format": "int64"
          },
          "type_relations_resolved": {
            "description": "`target_text` resolved to a real symbol in the same file — see\n`db::schema`'s `type_relations` table comment.",
            "type": "integer",
            "format": "int64"
          },
          "type_relations_textual": {
            "description": "`target_text` recorded but not resolved (cross-file, or no matching\nsame-file class) — still a real fact, just not yet linkable.",
            "type": "integer",
            "format": "int64"
          },
          "explicit_throws": {
            "type": "integer",
            "format": "int64"
          },
          "write_fields": {
            "type": "integer",
            "format": "int64"
          },
          "by_language": {
            "description": "Per-language breakdown, only languages with at least one fact of\neither kind. Lets an agent tell \"this language is under-covered\"\napart from \"the repo just has none of this language\" — see\n`indexer::semantic_facts`'s module doc comment for the per-language\nscope cuts (e.g. Go has none of these fact kinds at all).",
            "type": "array",
            "items": {
              "$ref": "#/$defs/SemanticFactsLanguageCountOutput"
            }
          }
        },
        "required": [
          "type_relations_total",
          "type_relations_resolved",
          "type_relations_textual",
          "explicit_throws",
          "write_fields",
          "by_language"
        ]
      },
      "SemanticFactsLanguageCountOutput": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          },
          "type_relations": {
            "type": "integer",
            "format": "int64"
          },
          "explicit_throws": {
            "type": "integer",
            "format": "int64"
          },
          "write_fields": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "language",
          "type_relations",
          "explicit_throws",
          "write_fields"
        ]
      },
      "ArchitectureDigestStatusOutput": {
        "type": "object",
        "properties": {
          "symbols_with_digest": {
            "type": "integer",
            "format": "int64"
          },
          "recursive_symbols": {
            "description": "Participates in a call cycle (Tarjan SCC over `Formal`/`Resolved`\nedges, or a direct self-loop) — see `graph::digest::compute_recursive_symbols`.",
            "type": "integer",
            "format": "int64"
          },
          "truncated_digests": {
            "description": "Digest's callee/effect lists were capped (`MAX_CALLEES_SHOWN` etc in\n`graph::digest`) — `rendered_text` is a real subset for these, not\nthe full picture.",
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "symbols_with_digest",
          "recursive_symbols",
          "truncated_digests"
        ]
      },
      "PackageDependenciesStatusOutput": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "manifests": {
            "description": "Distinct manifest files this scan found and successfully parsed.",
            "type": "integer",
            "format": "int64"
          },
          "by_ecosystem": {
            "description": "Only ecosystems with at least one dependency found — an absent\necosystem means either the project has no manifest of that kind,\nor (Java) that ecosystem isn't covered yet at all, see\n`indexer::package_deps`'s module doc comment.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/PackageEcosystemCountOutput"
            }
          }
        },
        "required": [
          "total",
          "manifests",
          "by_ecosystem"
        ]
      },
      "PackageEcosystemCountOutput": {
        "type": "object",
        "properties": {
          "ecosystem": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "ecosystem",
          "count"
        ]
      },
      "DerivedArtifactStatusOutput": {
        "description": "Derived-artifact freshness grouped by which reconciliation bucket\nactually invalidates them (see `InputCatalog::index_input_snapshot`) --\nNOT one status per fact type. `type_relations`/`symbol_effects` share one\nfingerprint (`config_material`, needs a full reparse to heal);\n`symbol_digests`/`package_dependencies` share a different one\n(`context_material`, a graph rebuild suffices). Reporting four\nindependently-looking statuses backed by only two real signals would\nimply false precision.",
        "type": "object",
        "properties": {
          "overall": {
            "description": "Worst-of-both-buckets convenience summary (`Stale` if either bucket\nis `Stale`, else `NeedsBaseline` if either needs one, else `Ready`) --\nfrom `calm_core::indexer::refresh::index_input_drift`'s single 4-way\nresult, for an agent that just wants \"is anything here stale\" without\nreading both fields below.",
            "$ref": "#/$defs/DerivedStatus"
          },
          "source_facts": {
            "description": "Covers `semantic_facts` (`type_relations` + `symbol_effects`) --\nkeyed by `SOURCE_EXTRACTION_VERSION`.",
            "$ref": "#/$defs/DerivedStatus"
          },
          "graph_facts": {
            "description": "Covers `architecture_digest` + `package_dependencies` -- keyed by\n`GRAPH_DERIVATION_VERSION` + `PACKAGE_GRAPH_VERSION`.",
            "$ref": "#/$defs/DerivedStatus"
          }
        },
        "required": [
          "overall",
          "source_facts",
          "graph_facts"
        ]
      },
      "DerivedStatus": {
        "description": "P1 (docs/plans/2026-08-08-derived-artifact-hardening-execution-plan.md):\nwhether a class of derived rows is trustworthy against the CURRENT\nnon-source inputs (see `calm_core::indexer::refresh::index_input_drift`),\nreplacing the previous ambiguous \"row present or absent\" signal --\nabsence used to mean \"never computed\" OR \"this repo genuinely has none\"\nOR \"stale after a config/logic change\" indistinguishably, and those call\nfor different agent reactions.\n\nOnly the three states backed by a real signal today are modeled.\n`unsupported`/`failed`/`disabled` (part of the original design sketch)\nare deliberately omitted: nothing in the pipeline tracks per-extractor\nfailure or a disable flag yet, and fabricating those from unrelated\nsignals would be worse than leaving them out.",
        "oneOf": [
          {
            "description": "Consistent with current source/config/context inputs as of the last\nsuccessful (re)index -- may still be legitimately EMPTY (a repo with\nzero throws is `Ready` with `explicit_throws: 0`, not `NeedsBaseline`).",
            "type": "string",
            "const": "ready"
          },
          {
            "description": "No index has ever run (`file_index` is empty) -- nothing to be stale\nrelative to yet.",
            "type": "string",
            "const": "needs_baseline"
          },
          {
            "description": "The persisted `index_input_state` contract disagrees with the\nproject's current config/context files, or predates whichever\n`*_VERSION` const now covers this fact type -- rows may reflect\nextraction/derivation logic older than the running binary.\nSelf-heals on the next incremental reindex/graph rebuild (see\n`index_input_drift`'s doc comment).",
            "type": "string",
            "const": "stale"
          }
        ]
      },
      "IdentityMigrationStatusOutput": {
        "type": "object",
        "properties": {
          "target_version": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "failed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "rows_rebuilt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "busy_retries": {
            "type": "integer",
            "format": "int64"
          },
          "graph_generation": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        },
        "required": [
          "target_version",
          "status",
          "busy_retries"
        ]
      },
      "WatcherHealthOutput": {
        "type": "object",
        "properties": {
          "lifecycle": {
            "description": "OS watcher lifecycle: `not_started`, `starting`, `armed`, `backoff`,\n`degraded`, or `stopped`.",
            "type": "string"
          },
          "armed": {
            "description": "Whether an OS subscription is currently armed. Independent of whether\nthe last completed index is fresh.",
            "type": "boolean"
          },
          "freshness": {
            "description": "Freshness of the last watcher-driven refresh: `unknown`, `fresh`,\n`retrying`, or `stale`.",
            "type": "string"
          },
          "last_event": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_refresh": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_refresh_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_reconciliation": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_reconciliation_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "consecutive_failures": {
            "description": "Failures to create/maintain the OS watcher itself.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "consecutive_refresh_failures": {
            "description": "Refresh failures while an OS watcher may still be armed.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "required": [
          "lifecycle",
          "armed",
          "freshness",
          "consecutive_failures",
          "consecutive_refresh_failures"
        ]
      },
      "ScipOverlayStatusOutput": {
        "description": "Local mirror of `calm_core::scip::OverlayStatus` — that type lives in\n`calm-core`, which doesn't depend on `schemars`, so it can't derive\n`JsonSchema` itself. Only exists when this crate is built with the\n`scip-overlay` feature (the same gate `calm_core::scip` itself is behind).",
        "type": "object",
        "properties": {
          "available": {
            "description": "`rust-analyzer` binary was found (PATH/rustup/VS Code) at last check.",
            "type": "boolean"
          },
          "up_to_date": {
            "description": "`false` means Rust source has changed since the last overlay run (or\nnone has ever run) — the next non-noop incremental reindex will\nactually invoke rust-analyzer again rather than cache-skip.",
            "type": "boolean"
          },
          "last_match_rate": {
            "description": "Fraction (0.0-1.0) of SCIP-resolved call sites represented by a\n`formal` edge as of the last real overlay run — absent if it's never\nactually run. A low value alongside a healthy `.scip` file usually\nmeans indexer-subroot paths aren't rebased correctly for wherever the\nindexer ran (see `parse::parse_index`'s `rebase_prefix`). Stale the\ninstant `up_to_date` is `false`.",
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "last_inserted": {
            "description": "New `call_edges` rows the last real overlay run inserted for a call\nsite tree-sitter's own candidate selection dropped entirely (e.g. name\nfan-out past `MAX_CALLEE_CANDIDATES`) — absent if it's never actually\nrun.",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint",
            "minimum": 0
          },
          "last_run": {
            "description": "ISO8601 timestamp of that same last real (non-cache-skip) run,\nabsent if it's never actually run.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "available",
          "up_to_date"
        ]
      },
      "PerLanguageOverlayStatus": {
        "description": "One `ScipOverlayStatusOutput` tagged with its `file_index.language`\nvalue — see `IndexingStatusOutput::scip_overlays`.",
        "type": "object",
        "properties": {
          "lang": {
            "type": "string"
          },
          "available": {
            "description": "`rust-analyzer` binary was found (PATH/rustup/VS Code) at last check.",
            "type": "boolean"
          },
          "up_to_date": {
            "description": "`false` means Rust source has changed since the last overlay run (or\nnone has ever run) — the next non-noop incremental reindex will\nactually invoke rust-analyzer again rather than cache-skip.",
            "type": "boolean"
          },
          "last_match_rate": {
            "description": "Fraction (0.0-1.0) of SCIP-resolved call sites represented by a\n`formal` edge as of the last real overlay run — absent if it's never\nactually run. A low value alongside a healthy `.scip` file usually\nmeans indexer-subroot paths aren't rebased correctly for wherever the\nindexer ran (see `parse::parse_index`'s `rebase_prefix`). Stale the\ninstant `up_to_date` is `false`.",
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "last_inserted": {
            "description": "New `call_edges` rows the last real overlay run inserted for a call\nsite tree-sitter's own candidate selection dropped entirely (e.g. name\nfan-out past `MAX_CALLEE_CANDIDATES`) — absent if it's never actually\nrun.",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint",
            "minimum": 0
          },
          "last_run": {
            "description": "ISO8601 timestamp of that same last real (non-cache-skip) run,\nabsent if it's never actually run.",
            "type": [
              "string",
              "null"
            ]
          },
          "install_hint": {
            "description": "One-line install command for this language's external SCIP indexer,\npresent only when `status.available == false`. Turns \"raw data, not\na verdict\" (see `HealthSummary::weak_cross_reference_languages`'s own\ndoc comment) into something actionable instead of requiring the\nreader to already know each provider's install story from memory —\n2026-07-15 UX audit finding: `available: false` alone gives no path\nforward. `None` when `available == true` (nothing to suggest) — a\nmissing hint is never itself a signal that nothing can be done, see\n`scip_install_hint`'s own doc comment for the \"no entry yet\" case.",
            "type": [
              "string",
              "null"
            ]
          },
          "indexed_file_count": {
            "description": "Number of indexed source files in this language — the denominator behind\n`last_match_rate`, so a near-zero rate over a handful of files reads as\nthe statistical artifact it is rather than a real cross-reference\nquality problem (self-audit F5). Summed across every `file_index.\nlanguage` this provider covers (javascript = js + ts, c = c + cpp).\n`None` only if the count query itself failed.",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        },
        "required": [
          "lang",
          "available",
          "up_to_date"
        ]
      },
      "LspProviderStatusOutput": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string"
          },
          "support_level": {
            "type": "string"
          },
          "binary": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "profile_fingerprint": {
            "type": "string"
          },
          "context_fingerprint": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "lang",
          "support_level",
          "profile_fingerprint",
          "context_fingerprint",
          "status"
        ]
      },
      "SuggestedNext": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "args": true,
          "gate": {
            "description": "Plan 3 §3.5(b): `Some(true)` iff skipping `tool` is actually\nhook-enforced (currently only the edit_context/edit_lines/edit_symbol\n→ diff_impact hints set this, via `suggested_gated`) — every other\nhint is left unset (`None`), meaning advisory-only. Lets an agent\ntell \"you'll be blocked if you skip this\" apart from \"you probably\nwant this next\" without re-deriving it from AGENTS.md prose each time.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "tool",
          "reason"
        ]
      }
    },
    "properties": {
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ErrorDetail"
          },
          {
            "type": "null"
          }
        ]
      },
      "indexing_phase": {
        "type": "string"
      },
      "indexing_error": {
        "description": "Error message from the most recent indexing failure, present only\nwhen `indexing_phase == \"failed\"` — see `IndexingPhase::Failed`.",
        "type": [
          "string",
          "null"
        ]
      },
      "files_indexed": {
        "description": "Wave 6 (audit follow-up, P1-B): `file_index` rows with real indexed\ncontent (`hash != ''`) -- excludes the placeholder rows\n`mark_file_index_skip_reason` inserts for a file that has NEVER\nbeen successfully indexed. A file skipped on the most recent pass\nbut successfully indexed on a prior one still counts here (it\ngenuinely has content, just possibly stale) -- see `skipped_files`\nfor which rows are in that state.",
        "type": "integer",
        "format": "int64"
      },
      "files_total": {
        "description": "Tier-0 source files currently discoverable on disk (respects\n`config.ignore`) — compare against `files_indexed` to see whether the\nindex is behind what's actually in the project tree.",
        "type": "integer",
        "format": "int64"
      },
      "skipped_files": {
        "description": "`file_index` rows currently carrying a `skip_reason` (4.1b,\ntruth-kernel-hardening plan) -- files that couldn't be read on their\nmost recent reindex pass, with why. Explains the common case where\n`files_indexed` (or its symbol/edge contribution) falls short of\n`files_total` for a reason other than \"still indexing\".",
        "$ref": "#/$defs/SkippedFilesStatusOutput"
      },
      "symbols_indexed": {
        "type": "integer",
        "format": "int64"
      },
      "edges_indexed": {
        "type": "integer",
        "format": "int64"
      },
      "embeddings_status": {
        "type": "string"
      },
      "embeddings_error": {
        "description": "Error message from the most recent embeddings failure, present only\nwhen `embeddings_status` is `\"failed\"` or `\"offline_unavailable\"` —\nsee `EmbedStatus::Failed`/`OfflineUnavailable`. `\"disabled\"` means\n`semantic_search.enabled` is `false` in config, not a failure — no\nerror accompanies it.",
        "type": [
          "string",
          "null"
        ]
      },
      "edges_ready": {
        "type": "boolean"
      },
      "last_updated": {
        "type": [
          "string",
          "null"
        ]
      },
      "external_proofs": {
        "description": "D4 proof freshness, grouped by persisted evidence state. A formal edge\nis only current external proof when its corresponding record is fresh.",
        "$ref": "#/$defs/ExternalProofStatusOutput"
      },
      "semantic_facts": {
        "description": "Tier 1 semantic facts (2026-08-07 roadmap T1) coverage — extends/\nimplements, explicit throws, field writes — see\n`indexer::semantic_facts`'s module doc comment for exactly what is\nand isn't captured per language. All-zero (not absent) on a repo\nwith no supported languages, same \"checked, found none\" contract\n`SymbolInfoOutput.type_relations`/`.effects` already use.",
        "$ref": "#/$defs/SemanticFactsStatusOutput"
      },
      "architecture_digest": {
        "description": "Tier 2 Architecture Digest (2026-08-07 roadmap T2) coverage — see\n`graph::digest`'s module doc comment. Compare `symbols_with_digest`\nagainst `symbols_indexed` to see how much of the graph currently\nhas a rendered digest (only `function`/`method`/`class`/`struct`/\n`trait`/`interface`/`constructor` kinds are digestable).",
        "$ref": "#/$defs/ArchitectureDigestStatusOutput"
      },
      "package_dependencies": {
        "description": "T4a Package Dependency Graph (2026-08-07 roadmap, TIER 4 first\nstage) — DECLARED external dependencies parsed from manifest files\n(Cargo.toml/package.json/go.mod/requirements.txt/pyproject.toml).\nSee `indexer::package_deps`'s module doc comment for exactly what\nis and isn't covered (notably: no Java pom.xml/build.gradle yet).",
        "$ref": "#/$defs/PackageDependenciesStatusOutput"
      },
      "derived_status": {
        "description": "P1 (docs/plans/2026-08-08-derived-artifact-hardening-execution-plan.md):\nfreshness of `semantic_facts`/`architecture_digest`/`package_dependencies`\nabove against the CURRENT project inputs -- see `DerivedArtifactStatusOutput`'s\ndoc comment for why this is two grouped statuses, not one per field.",
        "$ref": "#/$defs/DerivedArtifactStatusOutput"
      },
      "identity_migration": {
        "description": "Diagnostic state of the one-transaction CallSite identity migration.\nAbsent until a legacy database actually requires that migration.",
        "anyOf": [
          {
            "$ref": "#/$defs/IdentityMigrationStatusOutput"
          },
          {
            "type": "null"
          }
        ]
      },
      "graph_mode": {
        "description": "Which graph-rebuild path the most recent non-noop reindex took:\n`\"full\"`, `\"incremental\"`, or `\"full_fallback:<reason>\"` (Phase B\nL6 — `GraphMode::label`). Absent until this process has served one\nnon-noop reindex (edit tool or file watcher). Lets an agent confirm\nthe incremental path is actually engaged rather than silently\nfalling back to full rebuilds.",
        "type": [
          "string",
          "null"
        ]
      },
      "watcher": {
        "description": "Observation and refresh health of the background file watcher. This is\nintentionally not folded into `indexing_phase` or `graph_mode`: those\ndescribe the last index build, while this describes whether future disk\nchanges are observed and reconciled safely.",
        "$ref": "#/$defs/WatcherHealthOutput"
      },
      "scip_overlay": {
        "description": "`None` when this build wasn't compiled with the `scip-overlay` feature,\nor `rust.scip.enabled` is explicitly `false` — nothing to report.\nOtherwise reflects whether Rust call edges are currently up to date\nwith SCIP-upgraded (`formal`) confidence — see\n`calm_core::scip::overlay_status`.",
        "anyOf": [
          {
            "$ref": "#/$defs/ScipOverlayStatusOutput"
          },
          {
            "type": "null"
          }
        ]
      },
      "scip_overlays": {
        "description": "Superset of `scip_overlay` covering every SCIP provider (P2.6) —\n`rust`/`go`/`python`/`javascript`/`java`/`csharp`/`php`/`c` — instead of Rust alone. Empty when\nthis build lacks the `scip-overlay` feature. A language is omitted\n(not present with `available: false`) when its `enabled` config is\nexplicitly `false`, or when the project has no files in that\nlanguage at all (see `per_language_overlay_statuses`'s doc comment —\nthis also avoids an unconditional `npx`-based probe for languages\nthe project doesn't use) — nothing to report either way, same as\n`scip_overlay` being absent for the config reason.",
        "type": "array",
        "items": {
          "$ref": "#/$defs/PerLanguageOverlayStatus"
        }
      },
      "lsp_providers": {
        "description": "Current LSP provider probe/profile evidence. No automatic LSP session is\nstarted here: `status=not_run` remains honest until `lsp_refresh` runs.",
        "type": "array",
        "items": {
          "$ref": "#/$defs/LspProviderStatusOutput"
        }
      },
      "formal_resolution_timeouts": {
        "description": "ADR-A1: count of formal-resolution (StackGraph tier-3) cancellations\nsince this process started -- see `calm_core::indexer::pipeline::\nformal_resolution_timeout_count`. A cancelled resolution (hit\n`RESOLVE_TIMEOUT` under load) used to be silently indistinguishable\nfrom \"resolved, found nothing\", so a file's call edges could flip\nbetween `formal` and `textual` confidence across reindexes with no\nvisible signal. A nonzero, growing value here means that is\nhappening on this repo right now -- worth investigating which\nfiles/languages before trusting `formal` counts as fully stable.",
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "scip_stack_graphs_overrides": {
        "description": "Số edge SCIP đã ghi đè 1 verdict stack-graphs kể từ khi process khởi\nđộng -- xem `calm_core::scip::ingest::scip_stack_graphs_override_count`.\n`None` khi build thiếu feature `scip-overlay` (không có gì để báo\ncáo). Một con số dương, tăng dần trên 1 repo thật là tín hiệu đáng\nđiều tra thêm trước khi tin tuyệt đối `formal_source = 'stack_graphs'`\ntrên các ngôn ngữ chưa có SCIP overlay (hiện: Java).",
        "type": [
          "integer",
          "null"
        ],
        "format": "uint64",
        "minimum": 0
      },
      "orphaned_stack_graphs_edges": {
        "description": "D1 (2026-07-30 stack-graphs-demotion-lever, FM2): count of\n`call_edges` rows still carrying `formal_source = 'stack_graphs'`\neven though THIS build was compiled without the `stack-graphs-formal`\nfeature -- i.e. verdicts from a resolver that no longer exists in\nthis binary, which incremental reindex (only touches dirty files)\ncan never re-verify or refresh. `None` when this build HAS the\nfeature (nothing orphaned by definition). A nonzero value here is a\nreal, permanent trust gap on those specific edges until a full\nreindex on a build with the feature restored touches them again.",
        "type": [
          "integer",
          "null"
        ],
        "format": "uint64",
        "minimum": 0
      },
      "suggested_next": {
        "anyOf": [
          {
            "$ref": "#/$defs/SuggestedNext"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
